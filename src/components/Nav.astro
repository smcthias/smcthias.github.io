---
// v4 redesign nav: SAVELLE wordmark, a LET'S TALK pill (opens the contact
// modal via [data-contact-open]) and a MENU pill that reveals a full-screen
// drawer with Home/About/Work/Contact, plus two small secondary links
// (website survey, Substack). Contact in the drawer
// scrolls to the footer anchor (#contact); LET'S TALK opens the modal
// directly — both coexist per the design brief.
// Transparent, floating on the page — safe now that every page is dark.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header id="site-nav" class="fixed top-0 inset-x-0 z-90">
  <div class="px-5 sm:px-8 md:px-12">
    <div class="flex items-center justify-between h-16 md:h-auto md:py-12">
      <a href={`${base}/`} data-nav-intro class="font-head text-lg md:text-4xl font-normal tracking-tight text-zinc-50" aria-label="Savelle home">
        SAVELLE
      </a>

      <div class="flex items-center gap-3">
        <button
          type="button"
          data-contact-open
          data-nav-intro
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-zinc-950 text-sm md:text-lg font-semibold hover:bg-zinc-200 transition-colors cursor-pointer"
        >
          LET'S TALK
          <svg class="w-3.5 h-3.5 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M8 7h9v9" /></svg>
        </button>

        <button
          id="nav-menu-toggle"
          type="button"
          data-nav-intro
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-drawer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-zinc-50 text-sm md:text-lg font-semibold bg-zinc-800 hover:bg-zinc-900 transition-colors cursor-pointer"
        >
          <span id="nav-menu-label">MENU</span>
          <span class="nav-burger relative inline-flex items-center justify-center w-4 h-4" aria-hidden="true">
            <span class="nav-burger-bar nav-burger-top"></span>
            <span class="nav-burger-bar nav-burger-bottom"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="nav-drawer" class="nav-drawer fixed inset-0 z-80 bg-zinc-950" hidden>
  <nav class="h-full flex flex-col justify-center px-5 sm:px-8 md:px-12">
    <a href={`${base}/`} class="drawer-link">
      <span class="drawer-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
      </span>
      <span class="drawer-link-text">Home</span>
    </a>
    <a href={`${base}/about`} class="drawer-link">
      <span class="drawer-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
      </span>
      <span class="drawer-link-text">About</span>
    </a>
    <a href={`${base}/works`} class="drawer-link">
      <span class="drawer-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
      </span>
      <span class="drawer-link-text">Work</span>
    </a>
    <a href={`${base}/#contact`} class="drawer-link">
      <span class="drawer-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
      </span>
      <span class="drawer-link-text">Contact</span>
    </a>
    <button
      type="button"
      id="nav-survey-link"
      data-survey-open
      class="mt-10 self-start inline-flex items-center gap-2 text-sm sm:text-base font-medium text-zinc-500 hover:text-zinc-50 transition-colors cursor-pointer"
    >
      Is your website reaching your customers?
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
    </button>
    <a
      href="https://savelledesign.substack.com"
      target="_blank"
      rel="noopener"
      class="mt-3 self-start inline-flex items-center gap-2 text-sm sm:text-base font-medium text-zinc-500 hover:text-zinc-50 transition-colors"
    >
      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z" /></svg>
      Follow along on Substack
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9" /></svg>
    </a>
  </nav>
</div>

<style>
  .drawer-link {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
    font-family: var(--font-head);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fafafa;
    border-bottom: 1px solid #18181b;
    transition: color 0.2s;
  }
  .drawer-link:hover { color: #a1a1aa; }

  /* Arrow sits absolutely at the link's left edge, starting off past it
     (translateX) and invisible. On hover it slides in — passing over the
     word's own start as it travels — while the word shifts right by about
     the arrow's width to make room, landing clear of it rather than
     overlapping once settled. */
  .drawer-arrow {
    position: absolute;
    left: 0;
    display: inline-flex;
    width: clamp(1.5rem, 4vw, 2.25rem);
    opacity: 0;
    transform: translateX(-2.5rem);
    transition: transform 0.35s var(--ease-out-expo), opacity 0.3s var(--ease-out-expo);
    pointer-events: none;
  }
  .drawer-arrow svg { width: 100%; height: auto; }
  .drawer-link-text {
    display: inline-block;
    transition: transform 0.35s var(--ease-out-expo);
  }
  .drawer-link:hover .drawer-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .drawer-link:hover .drawer-link-text {
    transform: translateX(clamp(2rem, 5vw, 3rem));
  }

  .nav-burger-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out-expo);
  }
  .nav-burger-top { transform: translate(-50%, calc(-50% - 3px)); }
  .nav-burger-bottom { transform: translate(-50%, calc(-50% + 3px)); }
  #nav-menu-toggle[aria-expanded='true'] .nav-burger-top { transform: translate(-50%, -50%) rotate(45deg); }
  #nav-menu-toggle[aria-expanded='true'] .nav-burger-bottom { transform: translate(-50%, -50%) rotate(-45deg); }

  .nav-drawer {
    transition: opacity 0.25s var(--ease-out-expo);
  }
  .nav-drawer[hidden] { display: none; }
  .nav-drawer.is-closed { opacity: 0; pointer-events: none; }
</style>

<script>
  import { gsap } from 'gsap';

  // Wordmark + the two nav buttons drop/fade in TOGETHER (no stagger — a
  // single simultaneous beat, not sequenced word-by-word or card-by-card
  // like other reveals) on every page load — the one entrance animation on
  // the site that isn't scroll-triggered, since the nav is visible
  // immediately with nothing to scroll toward yet. Nav isn't
  // transition:persist'd, so this replays on every navigation, consistent
  // with how word-reveal/image-reveal also re-run per page.
  //
  // On the homepage this is the second beat of a deliberate sequence
  // (headline, then nav+logo together) — start right as the headline's
  // own word-reveal finishes: 8 words × 0.09s stagger + 0.9s duration =
  // 1.53s (src/pages/index.astro's hero h1, data-word-reveal-speed="slow").
  // Hardcoded rather than read from the DOM since word-reveal.ts doesn't
  // expose a per-element finish time; update this if that headline's word
  // count or speed ever changes. Elsewhere (no showreel on the page, i.e.
  // not the homepage) it plays almost immediately, same as before.
  function initNavIntro() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;
    const els = document.querySelectorAll<HTMLElement>('#site-nav [data-nav-intro]');
    if (!els.length) return;
    const isHomepage = !!document.querySelector('[data-reel-play]');
    const delay = isHomepage ? 1.53 : 0.1;
    gsap.set(els, { opacity: 0, y: -16 });
    gsap.to(els, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', delay });
  }

  function initNav() {
    const toggle = document.getElementById('nav-menu-toggle');
    const label = document.getElementById('nav-menu-label');
    const drawer = document.getElementById('nav-drawer');
    if (!toggle || !drawer || !label) return;

    // Cascading entrance for the drawer links each time the menu opens —
    // top-to-bottom stagger, each one dropping down into place slightly
    // after the one above it. Re-set every open (not just the first) since
    // by the next open the links are already sitting at their settled
    // opacity/y from the previous animation.
    const links = gsap.utils.toArray<HTMLElement>('.drawer-link', drawer);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const animateLinksIn = () => {
      if (reduced || !links.length) return;
      gsap.set(links, { opacity: 0, y: -24 });
      gsap.to(links, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', stagger: 0.08, delay: 0.05 });
    };

    const setDrawer = (open: boolean) => {
      if (open) {
        drawer.hidden = false;
        drawer.classList.add('is-closed');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          drawer.classList.remove('is-closed');
          animateLinksIn();
        }));
        window.__lenis?.stop();
      } else {
        drawer.classList.add('is-closed');
        window.setTimeout(() => { drawer.hidden = true; }, 250);
        window.__lenis?.start();
      }
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      label.textContent = open ? 'CLOSE' : 'MENU';
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setDrawer(Boolean(drawer.hidden)));
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setDrawer(false)));
    // Not an <a> (it opens the survey modal rather than navigating), so it
    // isn't covered by the querySelectorAll('a') above — close the drawer
    // on click same as the real nav links; the modal opening itself is
    // handled separately by SurveyModal.astro's document-level
    // [data-survey-open] listener.
    document.getElementById('nav-survey-link')?.addEventListener('click', () => setDrawer(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setDrawer(false);
    });
  }
  document.addEventListener('astro:page-load', initNav);
  document.addEventListener('astro:page-load', initNavIntro);
</script>
