---
// Top navigation. Dark, minimal, becomes a blurred bar once you scroll past the
// hero. Services + About open on hover (and keyboard focus) on desktop; the full
// list lives in the mobile drawer. Active state derived from the current path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const on = (frag: string) => path.includes(frag);

const services = [
  { href: '/services/landing-page-design', label: 'Landing Page Design' },
  { href: '/services/website-refresh', label: 'Website Refresh' },
  { href: '/services/brand-identity', label: 'Brand Identity' },
  { href: '/services/email-campaigns', label: 'Email Campaigns' },
];
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-colors duration-300 border-b border-transparent"
>
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Wordmark -->
      <a
        href={`${base}/`}
        class="group inline-flex items-center gap-1.5 text-lg font-display font-semibold tracking-tight text-paper"
        aria-label="Savelle Design — home"
      >
        <span aria-hidden="true" class="w-[3px] h-[17px] bg-accent transition-transform duration-300 group-hover:-translate-x-0.5"></span>
        <span>Savelle Design</span>
        <span aria-hidden="true" class="w-[3px] h-[17px] bg-accent transition-transform duration-300 group-hover:translate-x-0.5"></span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8 text-sm">
        <a href={`${base}/works`} class={`nav-link ${on('/works') ? 'is-active' : ''}`}>Work</a>

        <div class="relative group">
          <a
            href={`${base}/services`}
            class={`nav-link inline-flex items-center gap-1 ${on('/services') || on('/pricing') || on('/ux-') ? 'is-active' : ''}`}
          >
            Services
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
            <div class="w-64 bg-surface border border-line rounded-[2px] p-2 shadow-2xl shadow-black/40">
              <a href={`${base}/services`} class="menu-item font-medium">All Services</a>
              {services.map((s) => (
                <a href={`${base}${s.href}`} class={`menu-item pl-5 text-muted ${on(s.href) ? 'text-accent' : ''}`}>{s.label}</a>
              ))}
              <div class="my-2 border-t border-line"></div>
              <a href={`${base}/pricing`} class="menu-item">Pricing</a>
              <a href={`${base}/ux-health-check`} class="menu-item">UX Health Check <span class="text-accent text-xs">· free</span></a>
              <a href={`${base}/ux-audit`} class="menu-item">UX Audit</a>
            </div>
          </div>
        </div>

        <a href={`${base}/agencies`} class={`nav-link ${on('/agencies') ? 'is-active' : ''}`}>Agencies</a>

        <div class="relative group">
          <a
            href={`${base}/about`}
            class={`nav-link inline-flex items-center gap-1 ${on('/about') || on('/blog') ? 'is-active' : ''}`}
          >
            About
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
            <div class="w-44 bg-surface border border-line rounded-[2px] p-2 shadow-2xl shadow-black/40">
              <a href={`${base}/about`} class="menu-item">About Savelle</a>
              <a href={`${base}/blog`} class="menu-item">Blog</a>
            </div>
          </div>
        </div>

        <a
          href={`${base}/contact`}
          class="inline-flex items-center px-5 py-2.5 rounded-[2px] bg-accent text-ink font-medium hover:bg-accent-dim transition-colors"
        >
          Start a project
        </a>
      </nav>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-paper"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg id="nav-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.75" d="M4 8h16M4 16h16"/></svg>
        <svg id="nav-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.75" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-drawer"
    class="md:hidden hidden fixed inset-x-0 top-16 bottom-0 bg-ink/98 backdrop-blur-sm border-t border-line overflow-y-auto"
  >
    <nav class="px-5 py-8 flex flex-col gap-1 text-2xl font-display">
      <a href={`${base}/works`} class="drawer-link">Work</a>
      <a href={`${base}/services`} class="drawer-link">Services</a>
      <div class="pl-4 flex flex-col gap-1 text-base text-muted font-sans py-1">
        {services.map((s) => (
          <a href={`${base}${s.href}`} class="py-1.5 hover:text-accent transition-colors">{s.label}</a>
        ))}
        <a href={`${base}/pricing`} class="py-1.5 hover:text-accent transition-colors">Pricing</a>
      </div>
      <a href={`${base}/agencies`} class="drawer-link">Agencies</a>
      <a href={`${base}/ux-health-check`} class="drawer-link">UX Health Check <span class="text-accent text-base align-middle">· free</span></a>
      <a href={`${base}/about`} class="drawer-link">About</a>
      <a href={`${base}/blog`} class="drawer-link">Blog</a>
      <a
        href={`${base}/contact`}
        class="mt-6 inline-flex items-center justify-center px-6 py-4 rounded-[2px] bg-accent text-ink text-lg font-sans font-medium"
      >
        Start a project
      </a>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    color: var(--color-muted);
    transition: color 0.2s;
    padding-bottom: 2px;
  }
  .nav-link:hover,
  .nav-link.is-active { color: var(--color-paper); }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    height: 1.5px; width: 0;
    background: var(--color-accent);
    transition: width 0.25s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { width: 100%; }

  .menu-item {
    display: block;
    position: relative;
    padding: 0.5rem 0.75rem;
    border-radius: 2px;
    font-size: 0.875rem;
    color: var(--color-paper);
    transition: background 0.15s, color 0.15s;
  }
  .menu-item:hover { background: var(--color-surface-2); color: var(--color-accent); }
  /* registration bar slides in on the left — same mark as the wordmark */
  .menu-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    width: 3px;
    height: 0;
    background: var(--color-accent);
    transition: height 0.18s var(--ease-out-expo);
  }
  .menu-item:hover::before { height: 0.9em; }

  .drawer-link {
    padding: 0.6rem 0;
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    transition: color 0.2s;
  }
  .drawer-link:hover { color: var(--color-accent); }
</style>

<script>
  // Nav interactions: scrolled-bar background + mobile drawer.
  // Wrapped in astro:page-load so it re-binds after every View Transition.
  function initNav() {
    const nav = document.getElementById('site-nav');
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const openIcon = document.getElementById('nav-open-icon');
    const closeIcon = document.getElementById('nav-close-icon');
    if (!nav || !toggle || !drawer) return;

    const solid = () => {
      const scrolled = window.scrollY > 24;
      nav.classList.toggle('bg-ink/85', scrolled);
      nav.classList.toggle('backdrop-blur-md', scrolled);
      nav.classList.toggle('border-line', scrolled);
      nav.classList.toggle('border-transparent', !scrolled);
    };
    solid();
    window.addEventListener('scroll', solid, { passive: true });

    const setDrawer = (open: boolean) => {
      drawer.classList.toggle('hidden', !open);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () =>
      setDrawer(drawer.classList.contains('hidden'))
    );
    drawer.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setDrawer(false))
    );
  }
  document.addEventListener('astro:page-load', initNav);
</script>
