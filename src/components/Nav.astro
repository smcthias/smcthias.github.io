---
// Top navigation. Light, minimal, plain-text wordmark. Services + About open
// on hover (and keyboard focus) on desktop; the full list lives in the mobile
// drawer. The hamburger morphs into a close mark. Active state from the path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const on = (frag: string) => path.includes(frag);

const services = [
  { href: '/services/landing-page-design', label: 'Landing Page Design' },
  { href: '/services/website-refresh', label: 'Website Refresh' },
  { href: '/services/brand-identity', label: 'Brand Identity' },
  { href: '/services/email-campaigns', label: 'Email Campaigns' },
];
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-colors duration-300 border-b border-transparent"
>
  <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Wordmark: plain text, nothing else -->
      <a
        href={`${base}/`}
        class="text-lg font-semibold tracking-tight text-ink"
        aria-label="Savelle Design home"
      >
        Savelle Design
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8 text-sm">
        <a href={`${base}/works`} class={`nav-link ${on('/works') ? 'is-active' : ''}`}>Work</a>

        <div class="relative group">
          <a
            href={`${base}/services`}
            class={`nav-link inline-flex items-center gap-1 ${on('/services') || on('/pricing') || on('/ux-') ? 'is-active' : ''}`}
          >
            Services
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
            <div class="w-64 bg-card border border-hairline p-2 shadow-xl shadow-black/10">
              <a href={`${base}/services`} class="menu-item font-medium">All Services</a>
              {services.map((s) => (
                <a href={`${base}${s.href}`} class={`menu-item pl-5 text-slate ${on(s.href) ? 'font-medium text-ink' : ''}`}>{s.label}</a>
              ))}
              <div class="my-2 border-t border-hairline"></div>
              <a href={`${base}/pricing`} class="menu-item">Pricing</a>
              <a href={`${base}/ux-health-check`} class="menu-item">Website Score</a>
              <a href={`${base}/ux-audit`} class="menu-item">Website Audit</a>
            </div>
          </div>
        </div>

        <a href={`${base}/agencies`} class={`nav-link ${on('/agencies') ? 'is-active' : ''}`}>Agencies</a>

        <div class="relative group">
          <a
            href={`${base}/about`}
            class={`nav-link inline-flex items-center gap-1 ${on('/about') || on('/blog') ? 'is-active' : ''}`}
          >
            About
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
            <div class="w-44 bg-card border border-hairline p-2 shadow-xl shadow-black/10">
              <a href={`${base}/about`} class="menu-item">About Savelle</a>
              <a href={`${base}/blog`} class="menu-item">Blog</a>
            </div>
          </div>
        </div>

        <a
          href={`${base}/contact`}
          class="inline-flex items-center px-5 py-2.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors"
        >
          Start a project
        </a>
      </nav>

      <!-- Mobile toggle: two bars that morph into a close mark -->
      <button
        id="nav-toggle"
        class="nav-burger md:hidden relative inline-flex items-center justify-center w-10 h-10 -mr-2 text-ink"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="burger-bar burger-top" aria-hidden="true"></span>
        <span class="burger-bar burger-bottom" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-drawer"
    class="drawer md:hidden fixed inset-x-0 top-16 bottom-0 bg-paper border-t border-hairline overflow-y-auto"
    hidden
  >
    <nav class="px-5 py-8 flex flex-col gap-1 text-2xl font-semibold tracking-tight">
      <a href={`${base}/works`} class="drawer-link">Work</a>
      <a href={`${base}/services`} class="drawer-link">Services</a>
      <div class="pl-4 flex flex-col gap-1 text-base text-slate font-normal py-1">
        {services.map((s) => (
          <a href={`${base}${s.href}`} class="py-1.5 hover:text-ink transition-colors">{s.label}</a>
        ))}
        <a href={`${base}/pricing`} class="py-1.5 hover:text-ink transition-colors">Pricing</a>
      </div>
      <a href={`${base}/agencies`} class="drawer-link">Agencies</a>
      <a href={`${base}/ux-health-check`} class="drawer-link">Website Score</a>
      <a href={`${base}/about`} class="drawer-link">About</a>
      <a href={`${base}/blog`} class="drawer-link">Blog</a>
      <a
        href={`${base}/contact`}
        class="mt-6 inline-flex items-center justify-center px-6 py-4 bg-ink text-paper text-lg font-medium"
      >
        Start a project
      </a>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    color: var(--color-slate);
    transition: color 0.2s;
    padding-bottom: 2px;
  }
  .nav-link:hover,
  .nav-link.is-active { color: var(--color-ink); }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    height: 1.5px; width: 0;
    background: var(--color-ink);
    transition: width 0.25s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { width: 100%; }

  .menu-item {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    transition: background 0.15s;
  }
  .menu-item:hover { background: var(--color-paper); }

  .drawer-link {
    padding: 0.6rem 0;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Hamburger morph: two bars rotate into an X. Quick and smooth. */
  .burger-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out-expo);
  }
  .burger-top { transform: translate(-50%, calc(-50% - 4px)); }
  .burger-bottom { transform: translate(-50%, calc(-50% + 4px)); }
  .nav-burger[aria-expanded='true'] .burger-top { transform: translate(-50%, -50%) rotate(45deg); }
  .nav-burger[aria-expanded='true'] .burger-bottom { transform: translate(-50%, -50%) rotate(-45deg); }

  /* Drawer reveal: quick fade + short slide. */
  .drawer {
    transition: opacity 0.22s var(--ease-out-expo), transform 0.22s var(--ease-out-expo);
  }
  .drawer[hidden] { display: none; }
  .drawer.is-closed {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }
</style>

<script>
  // Nav interactions: scrolled-bar background + mobile drawer with morph.
  // Re-binds after every View Transition via astro:page-load.
  function initNav() {
    const nav = document.getElementById('site-nav');
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('mobile-drawer');
    if (!nav || !toggle || !drawer) return;

    const solid = () => {
      const scrolled = window.scrollY > 24;
      nav.classList.toggle('bg-paper/90', scrolled);
      nav.classList.toggle('backdrop-blur-md', scrolled);
      nav.classList.toggle('border-hairline', scrolled);
      nav.classList.toggle('border-transparent', !scrolled);
    };
    solid();
    window.addEventListener('scroll', solid, { passive: true });

    const setDrawer = (open: boolean) => {
      if (open) {
        drawer.hidden = false;
        drawer.classList.add('is-closed');
        requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.remove('is-closed')));
      } else {
        drawer.classList.add('is-closed');
        window.setTimeout(() => { drawer.hidden = true; }, 220);
      }
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setDrawer(Boolean(drawer.hidden)));
    drawer.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setDrawer(false))
    );
  }
  document.addEventListener('astro:page-load', initNav);
</script>
