---
// v4 redesign footer. Doubles as the "Contact" anchor target (#contact) —
// the nav's Contact drawer link and any /#contact link scroll here, while
// LET'S TALK opens the modal directly (both patterns from the brief).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer id="contact" class="relative z-10 bg-zinc-950 text-zinc-50 scroll-mt-20">
  <div class="px-5 sm:px-8 md:px-12 py-20 md:py-28">
    <div class="mb-20">
      <p data-word-reveal class="font-head text-huge md:text-9xl font-normal text-zinc-50">
        Let's make <br/> something great.
      </p>
      <p data-word-reveal data-word-reveal-speed="fast" class="mt-4 md:mt-12 text-lg md:text-4xl text-zinc-50 max-w-md">
        Tell me what you're building. I'll tell you how design gets it there.
      </p>
      <button
        type="button"
        data-contact-open
        data-drop-reveal
        class="mt-8 md:mt-16 inline-flex text-lg items-center gap-2 px-7 py-3.5 rounded-full bg-white text-zinc-950 font-semibold hover:bg-zinc-200 transition-colors cursor-pointer"
      >
        LET'S TALK
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M8 7h9v9" /></svg>
      </button>
    </div>

    <div class="mt-14 flex flex-col sm:flex-row sm:justify-between gap-10 sm:gap-8">
      <div>
      <button
        type="button"
        data-survey-open
        class="group inline-flex items-center gap-2 text-zinc-300 hover:text-white transition-colors cursor-pointer"
      >
        <span class="text-base sm:text-lg font-medium">Is your website reaching your customers?</span>
        <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M8 7h9v9" /></svg>
      </button>
      <p class="mt-1.5 text-sm text-zinc-500">A free design audit from an 18-year designer.</p>
      </div>

      <div class="sm:text-right">
        <a
          href="https://savelledesign.substack.com"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2 text-zinc-300 hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z" /></svg>
          <span class="text-base sm:text-lg font-medium">Everything I wish clients knew.</span>
          <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M8 7h9v9" /></svg>
        </a>
        <p class="mt-1.5 text-sm text-zinc-500">Read it on Substack.</p>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-zinc-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-sm text-zinc-500">
      <p>&copy; {year} Savelle Design. Built by hand in Scottsdale.</p>
      <div class="flex items-center gap-4">
        <span>Follow</span>
        <a href="https://www.linkedin.com/in/savelle/" target="_blank" rel="noopener" aria-label="Savelle on LinkedIn" class="text-zinc-400 hover:text-zinc-50 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.937 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
        </a>
        <a href="https://savelledesign.substack.com" target="_blank" rel="noopener" aria-label="Savelle on Substack" class="text-zinc-400 hover:text-zinc-50 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z" /></svg>
        </a>
      </div>
      <div class="flex items-center gap-6">
        <a href={`${base}/privacy`} class="hover:text-zinc-50 transition-colors">Privacy Policy</a>
        <a href={`${base}/terms`} class="hover:text-zinc-50 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
