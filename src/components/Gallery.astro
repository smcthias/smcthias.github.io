---
// Work gallery: masonry grid of single pieces + a Web/Email/Social/Brand
// filter. ONE FOLDER PER TILE: every subfolder of public/images/gallery/ is a
// tile. Inside a folder:
//   cover.jpg|png|webp   (optional) the image shown on the grid tile; without
//                        it, the first screenshot is used.
//   01-*.jpg, 02-*.png…  the screenshots shown in the modal, in filename order.
//   info.json            (optional) { "name", "description", "filters": [...],
//                        "featured": true, "order": 10 } — see CLAUDE.md.
// Folders starting with "_" or "." are ignored (a handy way to park a tile).
// Clicking a tile opens that piece's full-screen <dialog>. No titles on tiles;
// the only labels are the four filter names, and a chip only renders when some
// tile uses it. Tiles keep their natural aspect ratio so the masonry varies in
// size; images are lazy and fade/rise in as they enter view.
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const FILTERS = [
  { id: 'web', label: 'Web' },
  { id: 'email', label: 'Email' },
  { id: 'social', label: 'Social' },
  { id: 'brand', label: 'Brand' },
] as const;
const labelOf: Record<string, string> = Object.fromEntries(FILTERS.map((f) => [f.id, f.label]));

type Img = { src: string; w: number; h: number };
type Piece = {
  id: string;
  name: string;
  description?: string;
  filters: string[];
  feature: boolean;
  wide: boolean;
  order: number;
  cover: Img;
  shots: Img[];
};
type Info = { name?: string; description?: string; filters?: string[]; featured?: boolean; wide?: boolean; order?: number };

const IMAGE_RE = /\.(jpe?g|png|webp|avif|gif)$/i;
const galleryDir = path.join(process.cwd(), 'public/images/gallery');
const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });

const dims = async (file: string, src: string): Promise<Img> => {
  const m = await sharp(file).metadata();
  return { src, w: m.width ?? 800, h: m.height ?? 600 };
};

const pieces: Piece[] = [];
const folders = fs.existsSync(galleryDir)
  ? fs.readdirSync(galleryDir, { withFileTypes: true }).filter((d) => d.isDirectory() && !/^[_.]/.test(d.name))
  : [];

for (const dir of folders) {
  const full = path.join(galleryDir, dir.name);
  const all = fs.readdirSync(full).filter((f) => IMAGE_RE.test(f)).sort(collator.compare);
  if (!all.length) continue;

  const coverFile = all.find((f) => /^cover\./i.test(f));
  const shotFiles = all.filter((f) => f !== coverFile);
  const toImg = (f: string) => dims(path.join(full, f), `${base}/images/gallery/${dir.name}/${f}`);

  let info: Info = {};
  const infoPath = path.join(full, 'info.json');
  if (fs.existsSync(infoPath)) {
    try {
      info = JSON.parse(fs.readFileSync(infoPath, 'utf-8'));
    } catch (e) {
      throw new Error(`gallery: ${dir.name}/info.json is not valid JSON (${(e as Error).message})`);
    }
  }
  const filters = (info.filters ?? []).map((f) => f.toLowerCase());
  for (const f of filters) {
    if (!(f in labelOf)) throw new Error(`gallery: ${dir.name}/info.json has unknown filter "${f}" (use web, email, social, brand)`);
  }

  const shots = await Promise.all((shotFiles.length ? shotFiles : all).map(toImg));
  pieces.push({
    id: dir.name,
    name: info.name ?? dir.name,
    description: info.description,
    filters,
    feature: info.featured === true,
    wide: info.featured === true || info.wide === true,
    order: info.order ?? 9999,
    cover: coverFile ? await toImg(coverFile) : shots[0],
    shots,
  });
}

// Featured tiles first, then by "order" in info.json, then A–Z.
pieces.sort(
  (a, b) => Number(b.feature) - Number(a.feature) || a.order - b.order || collator.compare(a.name, b.name),
);

const used = new Set(pieces.flatMap((p) => p.filters));
const chips = FILTERS.filter((f) => used.has(f.id));
---

<div id="gallery" data-gallery>
  <div class="flex flex-wrap gap-2 md:gap-3 mb-10 md:mb-14" role="group" aria-label="Filter work">
    <button type="button" data-filter="all" aria-pressed="true" class="gallery-chip cursor-pointer">All</button>
    {chips.map((f) => (
      <button type="button" data-filter={f.id} aria-pressed="false" class="gallery-chip cursor-pointer">{f.label}</button>
    ))}
  </div>

  <div class="gallery-grid">
    {pieces.map((p, i) => (
      <button
        type="button"
        data-tile
        data-filters={p.filters.join(' ')}
        data-dialog={`g-${p.id}`}
        aria-label={`Open ${p.name}`}
        class:list={['gallery-tile group block w-full cursor-pointer overflow-hidden rounded-2xl bg-zinc-900', p.wide && 'gallery-feature']}
        style={!p.wide && p.cover.w > p.cover.h ? 'aspect-ratio: 1 / 1' : undefined}
      >
        <img
          src={p.cover.src}
          width={p.cover.w}
          height={p.cover.h}
          alt={`${p.name} work`}
          class:list={['w-full block', p.wide || p.cover.w > p.cover.h ? 'h-full object-cover object-top' : 'h-auto']}
          loading={i < 3 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </button>
    ))}
  </div>

  {pieces.map((p) => (
    <dialog id={`g-${p.id}`} class="gallery-dialog" aria-label={p.name}>
      <div data-gallery-scroll data-lenis-prevent class="gallery-scroll">
        <div class="gallery-modal-inner">
          <div class="flex flex-wrap gap-2">
            {p.filters.map((f) => (
              <p class="inline-block rounded-full border border-zinc-700 px-3 py-1 text-xs font-medium uppercase tracking-[0.15em] text-zinc-300">{labelOf[f]}</p>
            ))}
          </div>
          <h2 class="mt-5 pr-16 font-head text-4xl md:text-7xl font-normal text-zinc-50">{p.name}</h2>
          {p.description && <p class="mt-4 max-w-2xl text-lg md:text-xl text-zinc-300">{p.description}</p>}
          <div class:list={['gallery-shots mt-10 md:mt-14', p.shots.length === 1 && 'is-single', p.shots.length >= 3 && 'is-wide']}>
            {p.shots.map((img, i) => (
              <img
                src={img.src}
                width={img.w}
                height={img.h}
                alt={`${p.name} screenshot ${i + 1}`}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        </div>
      </div>

      <!-- Floating controls: fixed to the viewport, so they stay put while the modal scrolls. -->
      <button type="button" data-gallery-close aria-label="Close" class="gallery-float gallery-close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <button type="button" data-gallery-prev aria-label="Previous work" class="gallery-float gallery-prev">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 18l-6-6 6-6" /></svg>
      </button>
      <button type="button" data-gallery-next aria-label="Next work" class="gallery-float gallery-next">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 6l6 6-6 6" /></svg>
      </button>
    </dialog>
  ))}
</div>

<style>
  /* Masonry: a 1/2/3-column grid. The script (initGallery → layout) sets each
     tile's row span from its measured height on a 1px row grid, which packs
     tiles masonry-style and lets the feature tile span 2 of the 3 columns.
     Without JS it falls back to a plain stacked grid. */
  .gallery-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; }
  @media (min-width: 640px)  { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  .gallery-grid.is-masonry { grid-auto-flow: row dense; grid-auto-rows: 1px; row-gap: 0; }
  .gallery-tile { padding: 0; border: 0; position: relative; text-align: left; }
  .gallery-tile.is-jelly { z-index: 2; }
  /* Scaled, rounded, overflow-clipped tiles get aliased corner edges where the
     (often white) screenshot bleeds past the clip. Round the image itself too
     and give the tile its own compositing layer so the edge stays smooth. */
  .gallery-tile { isolation: isolate; clip-path: inset(0 round 1rem); background: transparent; }
  .gallery-tile > img { border-radius: inherit; }

  .gallery-tile:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  /* Feature tile: 2 of 3 columns (full width where there are only 1-2), cropped. */
  .gallery-feature { aspect-ratio: 4 / 3; }
  @media (min-width: 640px) { .gallery-feature { grid-column: span 2; aspect-ratio: 16 / 10; } }

  /* Reveal: tiles start faded/low and ease in when they scroll into view
     (script adds .is-in). Only when JS is on and motion is allowed. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .gallery-tile {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
      transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--d, 0ms);
    }
    .gallery-tile.is-in { opacity: 1; transform: none; }
  }

  .gallery-chip {
    border-radius: 9999px;
    border: 1px solid #3f3f46;
    padding: 0.5rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #fafafa;
    background: transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .gallery-chip:hover { border-color: #a1a1aa; }
  .gallery-chip[aria-pressed='true'] { background: #fff; color: #09090b; border-color: #fff; }
  .gallery-chip:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* Full-screen modal. Controls are position:fixed so they stay with the
     viewer while the content scrolls; the shots are a masonry (CSS columns). */
  .gallery-dialog {
    position: fixed; inset: 0;
    width: 100vw; max-width: none;
    height: 100dvh; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: #09090b;
    color: inherit;
  }
  .gallery-dialog::backdrop { background: #09090b; }
  @media (prefers-reduced-motion: no-preference) {
    .gallery-dialog[open] { animation: gallery-in 0.35s ease-out; }
  }
  @keyframes gallery-in { from { opacity: 0; } to { opacity: 1; } }

  .gallery-scroll { height: 100%; overflow-y: auto; padding: 5rem 1rem 6rem; }
  @media (min-width: 768px) { .gallery-scroll { padding: 6rem 5rem 5rem; } }
  .gallery-modal-inner { max-width: 1700px; margin: 0 auto; }

  .gallery-shots { columns: 1; column-gap: 1rem; }
  @media (min-width: 768px) { .gallery-shots { columns: 2; column-gap: 1.5rem; } }
  @media (min-width: 1280px) { .gallery-shots.is-wide { columns: 3; } }
  .gallery-shots.is-single { columns: 1; max-width: 64rem; margin-inline: auto; }
  .gallery-shots img {
    display: block; width: 100%; height: auto;
    margin-bottom: 1rem; break-inside: avoid;
    border-radius: 0.75rem; background: #18181b;
  }
  @media (min-width: 768px) { .gallery-shots img { margin-bottom: 1.5rem; } }

  .gallery-float {
    position: fixed; z-index: 10;
    display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: 9999px;
    color: #fafafa; cursor: pointer;
    background: rgba(24, 24, 27, 0.72);
    border: 1px solid #3f3f46;
    backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .gallery-float:hover { background: #fff; color: #09090b; }
  .gallery-float:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .gallery-close { top: 1rem; right: 1rem; }
  .gallery-prev, .gallery-next { bottom: 1.25rem; }
  .gallery-prev { left: 1rem; }
  .gallery-next { right: 1rem; }
  @media (min-width: 768px) {
    .gallery-close { top: 1.5rem; right: 1.5rem; }
    .gallery-prev, .gallery-next { bottom: auto; top: 50%; margin-top: -1.5rem; }
    .gallery-prev { left: 1.5rem; }
    .gallery-next { right: 1.5rem; }
  }
</style>

<script>
  function initGallery() {
    const root = document.querySelector<HTMLElement>('[data-gallery]');
    if (!root) return;
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('[data-tile]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Masonry layout: measure each visible tile and give it a row span on the
    // 1px-row grid (height + gap). Re-run on width changes and filtering.
    const grid = root.querySelector<HTMLElement>('.gallery-grid')!;
    const layout = () => {
      grid.classList.add('is-masonry');
      const gap = parseFloat(getComputedStyle(grid).columnGap) || 20;
      tiles.forEach((t) => {
        if (t.style.display === 'none') return;
        t.style.gridRowEnd = 'auto';
      });
      tiles.forEach((t) => {
        if (t.style.display === 'none') return;
        t.style.gridRowEnd = `span ${Math.ceil(t.offsetHeight + gap)}`;
      });
    };
    layout();
    let lastW = grid.clientWidth;
    new ResizeObserver(() => {
      if (grid.clientWidth !== lastW) { lastW = grid.clientWidth; layout(); }
    }).observe(grid);

    // Scroll reveal: a tile fades in once it's on screen AND its image has
    // loaded; tiles revealed in the same moment stagger slightly.
    let io: IntersectionObserver | null = null;
    let batch = 0;
    let batchTimer = 0;
    const reveal = (tile: HTMLElement) => {
      tile.style.setProperty('--d', `${Math.min(batch++, 6) * 90}ms`);
      window.clearTimeout(batchTimer);
      batchTimer = window.setTimeout(() => { batch = 0; }, 120);
      tile.classList.add('is-in');
    };
    const observe = () => {
      if (reduced || !('IntersectionObserver' in window)) {
        tiles.forEach((t) => t.classList.add('is-in'));
        return;
      }
      io?.disconnect();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const tile = e.target as HTMLElement;
            observer.unobserve(tile);
            const img = tile.querySelector('img');
            if (!img || img.complete) reveal(tile);
            else img.addEventListener('load', () => reveal(tile), { once: true });
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      io = observer;
      tiles.forEach((t) => {
        if (t.style.display !== 'none' && !t.classList.contains('is-in')) observer.observe(t);
      });
    };
    observe();

    // Jelly + magnetic hover, per tile — same spring model as the hero Play
    // pill (index.astro). The rAF loop runs only while hovered/settling, then
    // inline styles are cleared. Fine pointer + motion-allowed only.
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (fine.matches && !reduced) {
      type Spring = { p: number; v: number; t: number; k: number; c: number };
      const mk = (p: number, k: number, c: number): Spring => ({ p, v: 0, t: p, k, c });
      tiles.forEach((tile) => {
        const big = tile.classList.contains('gallery-feature');
        const HOVER_SCALE = big ? 1.015 : 1.035;
        const MAX_PULL = big ? 4 : 7;
        const x = mk(0, 180, 16), y = mk(0, 180, 16), sc = mk(1, 230, 11), wob = mk(0, 260, 7);
        const all = [x, y, sc, wob];
        let raf = 0, last = 0, hovering = false;

        const apply = () => {
          const w = wob.p;
          const sx = sc.p * (1 + w * 0.02);
          const sy = sc.p * (1 - w * 0.02);
          tile.style.transform = `translate3d(${x.p.toFixed(2)}px, ${y.p.toFixed(2)}px, 0) scale(${sx.toFixed(4)}, ${sy.toFixed(4)})`;
        };
        const clear = () => {
          ['transform', 'transition', 'will-change'].forEach((p) => tile.style.removeProperty(p));
          tile.classList.remove('is-jelly');
        };
        const step = (now: number) => {
          const dt = Math.min(0.032, (now - last) / 1000 || 0.016);
          last = now;
          const h = dt / 2;
          for (let i = 0; i < 2; i++) {
            for (const s of all) {
              s.v += (-s.k * (s.p - s.t) - s.c * s.v) * h;
              s.p += s.v * h;
            }
          }
          apply();
          if (all.every((s) => Math.abs(s.p - s.t) < 0.002 && Math.abs(s.v) < 0.01) && !hovering) {
            raf = 0;
            all.forEach((s) => { s.p = s.t; s.v = 0; });
            clear();
            return;
          }
          raf = requestAnimationFrame(step);
        };
        const wake = () => {
          if (raf) return;
          // Springs own the transform now: drop the reveal's CSS transition.
          tile.style.transition = 'none';
          tile.style.willChange = 'transform';
          tile.classList.add('is-jelly');
          last = performance.now();
          raf = requestAnimationFrame(step);
        };
        const move = (e: PointerEvent) => {
          const b = tile.getBoundingClientRect();
          const dx = e.clientX - (b.left + b.width / 2);
          const dy = e.clientY - (b.top + b.height / 2);
          const d = Math.hypot(dx, dy) || 1;
          const pull = Math.min(MAX_PULL, d * 0.04);
          x.t = (dx / d) * pull;
          y.t = (dy / d) * pull;
          wake();
        };
        tile.addEventListener('pointerenter', (e) => {
          if (e.pointerType !== 'mouse' || !tile.classList.contains('is-in')) return;
          hovering = true;
          sc.t = HOVER_SCALE;
          wob.v += 6;
          tile.addEventListener('pointermove', move);
          wake();
        });
        tile.addEventListener('pointerleave', () => {
          if (!hovering) return;
          hovering = false;
          tile.removeEventListener('pointermove', move);
          sc.t = 1; x.t = 0; y.t = 0;
          wob.v -= 3;
          wake();
        });
      });
    }

    // Filter (a piece can carry several filters)
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    // Filtering animates: leaving tiles shrink + fade, then the survivors
    // slide (FLIP) from their old spot to their new one; newly shown tiles
    // use the normal scroll reveal.
    let runId = 0;
    let running: Animation[] = [];
    const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const id = ++runId;
        running.forEach((a) => a.cancel());
        running = [];

        const matches = (t: HTMLElement) => f === 'all' || (t.dataset.filters ?? '').split(' ').includes(f);
        const wasShown = (t: HTMLElement) => t.style.display !== 'none';
        const leaving = tiles.filter((t) => wasShown(t) && !matches(t));
        const staying = tiles.filter((t) => wasShown(t) && matches(t));
        const entering = tiles.filter((t) => !wasShown(t) && matches(t));
        const first = new Map(staying.map((t) => [t, t.getBoundingClientRect()]));

        const apply = () => {
          if (id !== runId) return;
          leaving.forEach((t) => { t.style.display = 'none'; t.classList.remove('is-in'); });
          entering.forEach((t) => { t.classList.remove('is-in'); t.style.display = ''; });
          batch = 0;
          layout();
          if (!reduced) {
            staying.forEach((t) => {
              if (!t.classList.contains('is-in')) return;
              const a = first.get(t)!, b = t.getBoundingClientRect();
              const dx = a.left - b.left, dy = a.top - b.top;
              if (!dx && !dy) return;
              running.push(t.animate(
                [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
                { duration: 650, easing: EASE },
              ));
            });
          }
          observe();
        };

        if (reduced || !leaving.length) { apply(); return; }
        const outs = leaving.map((t) =>
          t.animate(
            [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.82)' }],
            { duration: 280, easing: 'ease-in', fill: 'forwards' },
          ),
        );
        running = outs;
        Promise.all(outs.map((a) => a.finished)).then(apply, () => {});
      }),
    );

    // Modal: full screen, arrows step through the currently visible works.
    const lenis = () => (window as any).__lenis;
    const visibleTiles = () => tiles.filter((t) => t.style.display !== 'none');
    let currentTile: HTMLElement | null = null;
    const dialogOf = (tile: HTMLElement) => document.getElementById(tile.dataset.dialog!) as HTMLDialogElement | null;

    const openTile = (tile: HTMLElement) => {
      const dlg = dialogOf(tile);
      if (!dlg) return;
      currentTile = tile;
      dlg.showModal();
      lenis()?.stop();
      dlg.querySelector<HTMLElement>('[data-gallery-scroll]')?.scrollTo(0, 0);
      const multiple = visibleTiles().length > 1;
      dlg.querySelectorAll<HTMLElement>('[data-gallery-prev],[data-gallery-next]').forEach((b) => {
        b.style.display = multiple ? '' : 'none';
      });
      dlg.focus({ preventScroll: true });
    };
    const step = (dir: 1 | -1) => {
      const list = visibleTiles();
      if (!currentTile || list.length < 2) return;
      const i = list.indexOf(currentTile);
      const next = list[(i + dir + list.length) % list.length];
      const from = dialogOf(currentTile);
      from?.close();
      openTile(next);
    };

    tiles.forEach((tile) => tile.addEventListener('click', () => openTile(tile)));
    root.querySelectorAll<HTMLDialogElement>('dialog').forEach((dlg) => {
      // 'close' fires async; only resume smooth scroll if no other modal took over.
      dlg.addEventListener('close', () =>
        setTimeout(() => {
          if (!document.querySelector('dialog[open]')) lenis()?.start();
        }, 0),
      );
      dlg.querySelector('[data-gallery-close]')?.addEventListener('click', () => dlg.close());
      dlg.querySelector('[data-gallery-prev]')?.addEventListener('click', () => step(-1));
      dlg.querySelector('[data-gallery-next]')?.addEventListener('click', () => step(1));
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      });
    });
  }
  document.addEventListener('astro:page-load', initGallery);
</script>
