---
// Ambient reel layer — fills a positioned 16:9 parent. The poster paints
// immediately (it's the hero LCP); the self-hosted muted loop (an MP4 in
// public/images/reel/, NOT Vimeo) is injected only after load, and only when
// motion is allowed and the visitor isn't on Save-Data. Poster stays
// otherwise. The Vimeo player is loaded solely by <ReelLightbox /> when a
// [data-reel-play] trigger is clicked (full playback with sound).
interface Props {
  poster?: string;
  src?: string;
  ambient?: boolean;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  poster = `${base}/images/reel/reel-poster.jpg`,
  src = `${base}/images/reel/SavelleDesign-PortfolioShowreelV2-Loop.mp4`,
  ambient = true,
} = Astro.props;
---

<div class="reel" data-reel-ambient data-src={src} data-ambient={ambient ? 'true' : 'false'} aria-hidden="true">
  <img src={poster} alt="" class="reel-poster" width="1920" height="1080" fetchpriority="high" />
  <div class="reel-mount" data-reel-ambient-mount></div>
</div>

<style>
  .reel { position: absolute; inset: 0; overflow: hidden; background: #09090b; }
  .reel-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel-mount { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s ease; }
  .reel-mount.is-live { opacity: 1; }
  /* object-fit: cover — the ambient reel is deliberately cropped (unlike
     the full-sound lightbox, which shows the whole frame). */
  .reel-mount :global(video) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; pointer-events: none;
  }
</style>

<script>
  function initReelAmbient() {
    const reel = document.querySelector<HTMLElement>('[data-reel-ambient]');
    const mount = reel?.querySelector<HTMLElement>('[data-reel-ambient-mount]');
    if (!reel || !mount) return;
    const wantAmbient = reel.dataset.ambient === 'true';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData === true;
    if (!wantAmbient || reduced || saveData || mount.dataset.loaded) return;

    const load = () => {
      if (mount.dataset.loaded) return;
      mount.dataset.loaded = '1';
      const v = document.createElement('video');
      v.muted = true;
      v.loop = true;
      v.autoplay = true;
      v.playsInline = true;
      v.setAttribute('tabindex', '-1');
      v.setAttribute('aria-hidden', 'true');
      v.addEventListener('playing', () => mount.classList.add('is-live'), { once: true });
      v.src = reel.dataset.src!;
      mount.appendChild(v);
      v.play().catch(() => {});
    };
    // Defer past first paint so it never competes with LCP.
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(load, { timeout: 2500 });
    } else {
      setTimeout(load, 1200);
    }
  }
  document.addEventListener('astro:page-load', initReelAmbient);
</script>
