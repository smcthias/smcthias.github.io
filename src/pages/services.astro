---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
  {
    href: '/services/landing-page-design',
    title: 'Landing Page Design',
    line: 'One page built around one goal: the signup, the demo, the sale. Designed mobile-first, built fast, measured from day one.',
    art: 'browser',
  },
  {
    href: '/services/website-refresh',
    title: 'Website Refresh & Redesign',
    line: 'A modern look and a cleaner path through your site. Keep what works, fix what fails, without starting over.',
    art: 'layers',
  },
  {
    href: '/services/brand-identity',
    title: 'Brand Identity Touchups',
    line: 'Logo, color, and type refined into a look your whole team can keep consistent, in print and on screen.',
    art: 'mark',
  },
  {
    href: '/services/email-campaigns',
    title: 'Email Campaign Design',
    line: 'Campaigns and templates people open, read, and act on, designed for the inbox and ready for your platform.',
    art: 'cards',
  },
];

const steps = [
  { title: 'Discovery', body: 'We get clear on your goals, your audience, and what the project has to accomplish.' },
  { title: 'Design', body: 'Mockups and prototypes grounded in research and what works for real visitors.' },
  { title: 'Development', body: 'Clean, fast code on modern tooling, so the site performs as well as it looks.' },
  { title: 'Launch', body: 'Testing, refining, and shipping, with support once it goes live.' },
];
---

<Layout
  title="Services - Savelle Design"
  description="Landing pages, website refreshes, brand identity, and email campaigns. Senior design and development for startups, agencies, and enterprise marketing teams."
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="pt-16 md:pt-28 pb-16 md:pb-24">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">What I do</p>
      <h1 class="font-semibold text-mega text-ink max-w-[15ch]">
        The work I take on.
      </h1>
      <p class="mt-10 max-w-2xl text-lg md:text-xl text-slate leading-relaxed">
        Landing pages, website refreshes, brand identity, and email. Practical
        design that moves the number that matters, for startups, agencies, and
        enterprise marketing teams.
      </p>
    </div>
  </section>

  <!-- ── The four services: two per row, room to breathe ──────────────── -->
  <section class="pb-24 md:pb-36">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-20 md:gap-y-28">
        {services.map((s) => (
          <a href={`${base}${s.href}`} class="group block min-w-0">
            <div class="aspect-[16/9] bg-card border border-hairline flex items-center justify-center mb-8 overflow-hidden">
              <svg class="w-40 h-40 text-mist transition-transform duration-500 group-hover:scale-105" viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                {s.art === 'browser' && (
                  <g transform="translate(80 84) scale(1 0.55) rotate(-30)">
                    <rect x="-44" y="-44" width="88" height="88" />
                    <line x1="-44" y1="-26" x2="44" y2="-26" />
                    <rect x="-32" y="-12" width="40" height="10" />
                    <rect x="-32" y="6" width="64" height="6" />
                    <rect x="-32" y="18" width="52" height="6" />
                    <rect x="-32" y="32" width="24" height="10" />
                  </g>
                )}
                {s.art === 'layers' && (
                  <g transform="translate(80 80)">
                    <g transform="scale(1 0.55) rotate(-30)"><rect x="-40" y="-40" width="80" height="80" /></g>
                    <g transform="translate(0 -22) scale(1 0.55) rotate(-30)"><rect x="-40" y="-40" width="80" height="80" /></g>
                    <g transform="translate(0 -44) scale(1 0.55) rotate(-30)"><rect x="-40" y="-40" width="80" height="80" /></g>
                  </g>
                )}
                {s.art === 'mark' && (
                  <g transform="translate(80 80)">
                    <circle cx="0" cy="0" r="44" />
                    <circle cx="0" cy="0" r="24" />
                    <line x1="-56" y1="0" x2="56" y2="0" />
                    <line x1="0" y1="-56" x2="0" y2="56" />
                  </g>
                )}
                {s.art === 'cards' && (
                  <g transform="translate(80 88) scale(1 0.55) rotate(-30)">
                    <rect x="-48" y="-32" width="64" height="44" />
                    <g transform="translate(14 -14)"><rect x="-48" y="-32" width="64" height="44" /></g>
                    <g transform="translate(28 -28)">
                      <rect x="-48" y="-32" width="64" height="44" />
                      <line x1="-48" y1="-32" x2="-16" y2="-6" />
                      <line x1="16" y1="-32" x2="-16" y2="-6" />
                    </g>
                  </g>
                )}
              </svg>
            </div>
            <h2 class="text-big font-semibold text-ink group-hover:underline underline-offset-8 decoration-hairline">{s.title}</h2>
            <p class="mt-3 text-lg text-slate leading-relaxed max-w-md">{s.line}</p>
            <span class="mt-5 inline-flex items-center gap-2 font-medium text-ink">View the service <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="border-y border-hairline py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">How it works</p>
      <h2 class="text-huge font-semibold text-ink max-w-3xl">A straight line from brief to launch.</h2>
      <p class="mt-6 text-lg text-slate leading-relaxed max-w-2xl">
        Every project runs the same way, with AI integrated at each step. You get
        the speed of a full team and the judgment of one accountable senior designer.
      </p>
      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-10">
        {steps.map((step) => (
          <div class="min-w-0 border-t border-hairline pt-6">
            <h3 class="text-xl font-semibold text-ink mb-2">{step.title}</h3>
            <p class="text-slate leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Pricing ──────────────────────────────────────────────────────── -->
  <section class="py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="border border-hairline bg-card p-10 md:p-16 grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
        <div class="min-w-0 lg:col-span-7">
          <p class="label mb-5">Pricing</p>
          <h2 class="text-huge font-semibold text-ink max-w-[16ch]">Real numbers, published up front.</h2>
        </div>
        <div class="min-w-0 lg:col-span-5 flex flex-col gap-8">
          <p class="text-lg text-slate leading-relaxed">
            Every service has a published range you can plan around, and we agree
            on a fixed price before any work starts. Scope flexes to fit your
            budget. No hourly surprises.
          </p>
          <a href={`${base}/pricing`} class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors self-start">
            See pricing
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Closing ──────────────────────────────────────────────────────── -->
  <section class="border-t border-hairline py-24 md:py-32">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <h2 class="text-huge font-semibold text-ink max-w-3xl">Let's talk about your project.</h2>
      <div class="mt-10">
        <a href={`${base}/contact`} class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors">
          Start your project
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
