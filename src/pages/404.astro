---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Page Not Found - Savelle Design"
  description="This page doesn't exist. Head back to the homepage or see the work."
>
  <section class="py-28 md:py-44">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <h1 class="text-mega font-semibold text-ink max-w-[16ch]">This page doesn't exist.</h1>
      <div class="mt-12 flex flex-wrap items-center gap-6">
        <a href={`${base}/`} class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors">
          Back to the homepage
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={`${base}/works`} class="text-ink font-medium underline underline-offset-8 decoration-hairline hover:decoration-ink transition-colors">
          See the work
        </a>
      </div>
    </div>
  </section>
</Layout>
