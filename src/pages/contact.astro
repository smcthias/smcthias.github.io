---
import Layout from '../layouts/Layout.astro';
import WebsiteScoreChat from '../components/WebsiteScoreChat.astro';

// ──────────────────────────────────────────────────────────────────────────
// DEFERRED ACTIVATION (same pattern as the Website Score tool)
// FORM_ENDPOINT: static-friendly form endpoint the form POSTs JSON to:
//   { name, email, message, ...utm }. Currently wired to the same Google
//   Apps Script sheet as the Website Score leads.
// BOOKING_URL: set to a Cal.com / Calendly link to enable the "Book a call"
//   path (the secondary CTA appears only when this is set).
const FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbxg4JxjE1jK4HHB19KOuXcHyNZT37dKvmwN0e8wz-ufeosZEeGMnT774Uk9rLjah3TW/exec';
const BOOKING_URL = '';

const testimonial = {
  quote:
    "Savelle is one of the most talented UX experts I've had the pleasure of working with. Within a very short period of time after his hire, he was knocking out work items and client side code. The impact of his effort and his work will be felt for a very long time.",
  name: 'Daniel Kruger',
  title: 'VP of Software Development',
  company: 'SyberSafe',
};
---

<Layout
  title="Work With Me - Savelle Design"
  description="Start a project with Savelle Design. Web design, branding, and development for startups, agencies, and enterprise teams. You'll hear back personally within one business day."
>
  <!-- Hero -->
  <section class="pt-16 md:pt-28 pb-16 md:pb-20">
    <div class="px-5 sm:px-8">
      <h1 class="text-mega font-semibold text-ink">
        Tell me what's broken. I'll tell you how I'll fix it.
      </h1>
    </div>
  </section>

  <!-- Two-column: trust rail + form -->
  <section class="pb-24 md:pb-32">
    <div class="px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <!-- Form (first on mobile, the action) -->
        <div class="order-1 lg:order-2 min-w-0">
          <form
            id="contact-form"
            data-endpoint={FORM_ENDPOINT}
            action={FORM_ENDPOINT}
            method="POST"
            class="bg-card border border-hairline p-8"
            novalidate
          >
            <h2 class="text-2xl font-semibold text-ink mb-6">Tell me about your project</h2>

            <!-- hidden attribution fields (populated by script) -->
            <input type="hidden" name="form_type" value="contact" />
            <input type="hidden" name="site" value="savelledesign.com" />
            <input type="hidden" name="utm_source" />
            <input type="hidden" name="utm_medium" />
            <input type="hidden" name="utm_campaign" />
            <input type="hidden" name="utm_content" />
            <!-- honeypot -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <div class="space-y-6">
              <div>
                <label for="cf-name" class="block text-sm text-slate mb-2">Name</label>
                <input id="cf-name" name="name" type="text" required autocomplete="name"
                  class="w-full bg-paper border border-hairline px-4 py-3 text-base text-ink placeholder-mist focus:outline-hidden focus:border-ink transition-colors" />
                <p data-error-for="cf-name" class="text-sm text-red-600 mt-1.5 hidden" role="alert">Please enter your name.</p>
              </div>

              <div>
                <label for="cf-email" class="block text-sm text-slate mb-2">Work email</label>
                <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com"
                  class="w-full bg-paper border border-hairline px-4 py-3 text-base text-ink placeholder-mist focus:outline-hidden focus:border-ink transition-colors" />
                <p data-error-for="cf-email" class="text-sm text-red-600 mt-1.5 hidden" role="alert">Please enter a valid email address.</p>
              </div>

              <div>
                <label for="cf-message" class="block text-sm text-slate mb-2">Tell me about the project</label>
                <textarea id="cf-message" name="message" rows="5" required
                  class="w-full bg-paper border border-hairline px-4 py-3 text-base text-ink placeholder-mist focus:outline-hidden focus:border-ink transition-colors resize-y"
                  placeholder="The project, what's not working, and what success looks like."></textarea>
                <p data-error-for="cf-message" class="text-sm text-red-600 mt-1.5 hidden" role="alert">Please add a few details.</p>
              </div>
            </div>

            <button type="submit" id="cf-submit"
              class="mt-8 w-full inline-flex items-center justify-center px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
              <span id="cf-submit-label">Send project inquiry</span>
              <svg id="cf-spinner" class="hidden ml-2 w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
              </svg>
            </button>

            <p id="cf-form-error" class="text-sm text-red-600 mt-4 hidden" role="alert"></p>
            <p class="text-xs text-mist mt-4">No newsletter. This goes straight to my inbox, and I reply personally within one business day.</p>
          </form>

          <!-- Success state (replaces the form) -->
          <div id="contact-success" class="bg-card border border-hairline p-10 text-center" hidden>
            <div class="w-14 h-14 mx-auto bg-ink flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-paper" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <h2 class="text-2xl font-semibold text-ink mb-2">Got it<span id="cf-success-name"></span>. Your inquiry is in.</h2>
            <p class="text-slate">I read every message personally and reply within one business day. Talk soon.</p>
          </div>

          <!-- Secondary contact method -->
          <p class="text-sm text-mist mt-6">
            <a href="https://www.linkedin.com/in/savelle/" target="_blank" rel="noopener noreferrer" class="text-slate underline underline-offset-4 decoration-hairline hover:decoration-ink transition-colors">Connect on LinkedIn</a>
          </p>
        </div>

        <!-- Trust rail -->
        <div class="order-2 lg:order-1 min-w-0">
          {BOOKING_URL && (
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 mb-14 border border-ink text-ink font-medium hover:bg-ink hover:text-paper transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Book a 30-minute intro call
            </a>
          )}

          <!-- Proof: testimonial -->
          {testimonial && (
            <figure class="border-t border-hairline pt-8">
              <blockquote class="text-slate leading-relaxed mb-4">&ldquo;{testimonial.quote}&rdquo;</blockquote>
              <figcaption class="text-sm">
                <span class="text-ink font-medium">{testimonial.name}</span>
                <span class="text-mist"> · {testimonial.title}, {testimonial.company}</span>
              </figcaption>
            </figure>
          )}

          <p class="text-sm text-mist mt-10">NDAs welcome · Based in Scottsdale, AZ · Working with teams anywhere</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      const endpoint = (form.dataset.endpoint || '').trim();
      const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
      const submitLabel = document.getElementById('cf-submit-label')!;
      const spinner = document.getElementById('cf-spinner')!;
      const formError = document.getElementById('cf-form-error')!;
      const successEl = document.getElementById('contact-success')!;
      const successName = document.getElementById('cf-success-name')!;

      // Populate attribution fields from the landing URL.
      const params = new URLSearchParams(window.location.search);
      (['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'] as const).forEach((k) => {
        const input = form.querySelector(`input[name="${k}"]`) as HTMLInputElement | null;
        if (input) input.value = params.get(k) || '';
      });

      const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());

      function showFieldError(id: string, show: boolean) {
        const el = form!.querySelector(`[data-error-for="${id}"]`);
        el?.classList.toggle('hidden', !show);
      }

      function validate() {
        const name = (form!.querySelector('#cf-name') as HTMLInputElement).value.trim();
        const email = (form!.querySelector('#cf-email') as HTMLInputElement).value;
        const message = (form!.querySelector('#cf-message') as HTMLTextAreaElement).value.trim();
        showFieldError('cf-name', !name);
        showFieldError('cf-email', !emailOk(email));
        showFieldError('cf-message', !message);
        return !!name && emailOk(email) && !!message;
      }

      // Clear an error as the user fixes it.
      ['cf-name', 'cf-email', 'cf-message'].forEach((id) => {
        form!.querySelector(`#${id}`)?.addEventListener('input', () => showFieldError(id, false));
      });

      function setLoading(on: boolean) {
        submitBtn.disabled = on;
        spinner.classList.toggle('hidden', !on);
        submitLabel.textContent = on ? 'Sending…' : 'Send project inquiry';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.classList.add('hidden');
        if ((form.querySelector('input[name="_gotcha"]') as HTMLInputElement).value) return; // bot
        if (!validate()) {
          (form.querySelector('[data-error-for]:not(.hidden)') as HTMLElement)
            ?.previousElementSibling?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        const data = Object.fromEntries(new FormData(form).entries());
        delete (data as Record<string, unknown>)._gotcha;
        setLoading(true);

        try {
          if (endpoint) {
            // Google Apps Script (and similar static-friendly endpoints) don't return
            // CORS headers, so we send a simple no-cors POST. The response is opaque;
            // a resolved fetch means the request was delivered. A network failure
            // rejects and is handled below (with the email fallback).
            await fetch(endpoint, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify(data),
            });
          }

          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'generate_lead', { method: 'contact_form' });
          }

          successName.textContent = data.name ? `, ${String(data.name).split(' ')[0]}` : '';
          form.hidden = true;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (_) {
          setLoading(false);
          formError.innerHTML =
            'Something went wrong sending that. Please try again, or reach out on <a class="underline" href="https://www.linkedin.com/in/savelle/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.';
          formError.classList.remove('hidden');
        }
      });
    }
  </script>

  <WebsiteScoreChat page="contact" />
</Layout>
