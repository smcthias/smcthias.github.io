---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const STRIPE_URL = 'https://buy.stripe.com/9B614nadB2L82Aw01c7wA00';

// FAQ schema is derived from the on-page Q&As below; keep the two in sync.
const faqs = [
  {
    question: 'What if my product is complex or has multiple user types?',
    answer:
      "The audit covers your primary user journey and key conversion paths. If you have multiple personas or complex workflows, I'll focus on the most critical business-impacting areas within the 48-hour timeframe.",
  },
  {
    question: 'Do you sign NDAs?',
    answer:
      "Absolutely. I'm happy to sign an NDA before accessing your product or any confidential information.",
  },
  {
    question: 'What if I need help implementing the recommendations?',
    answer:
      'The audit includes implementation guidance, but if you need hands-on help, I offer ongoing design services. We can discuss this during the strategy call.',
  },
  {
    question: 'Is there a money-back guarantee?',
    answer:
      "Yes. If you're not satisfied with the audit quality, I'll refund your investment, no questions asked. I stand behind my work.",
  },
  {
    question: 'Can you audit mobile apps?',
    answer:
      'Yes. The audit works for web applications, mobile apps (iOS/Android), and responsive websites. Just provide TestFlight access or an APK for mobile apps.',
  },
  {
    question: 'How soon can you start?',
    answer:
      "I begin within one business day of receiving access and deliver your complete audit within two business days of starting. Requests that come in over the weekend start the next business day, so if you send access Friday evening you'll have your audit back early the following week.",
  },
];

const siteUrl = (Astro.site || 'https://savelledesign.com').toString().replace(/\/$/, '');

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: '48-Hour Website Audit',
    serviceType: 'Website Audit',
    description:
      'An expert read on why a website is not converting, delivered in 48 hours: a recorded walkthrough video, a prioritized list of fixes, quick-win recommendations, and a 60-minute strategy call.',
    url: `${siteUrl}/ux-audit`,
    provider: { '@type': 'Person', name: 'Savelle McThias' },
    offers: { '@type': 'Offer', price: '997', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<Layout
  title="48-Hour Website Audit - Savelle Design"
  description="An expert read on why your site isn't converting, delivered in 48 hours. A recorded walkthrough, a prioritized list of fixes, and a strategy call for a fixed $997."
>
  <!-- Hero -->
  <section class="pt-16 md:pt-28 pb-16 md:pb-24">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">Website Audit · 48-hour turnaround</p>
      <h1 class="text-mega font-semibold text-ink max-w-[16ch]">
        An expert read on why your site isn't converting.
      </h1>
      <p class="mt-8 text-lg md:text-xl text-slate leading-relaxed max-w-2xl">
        Delivered in 48 hours. I go through your site the way a first-time customer would,
        record everything that gets in the way, and hand you a prioritized plan to fix it.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href={STRIPE_URL} class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors">
          Get your audit for $997
        </a>
        <a href="#whats-included" class="text-ink font-medium underline underline-offset-8 decoration-hairline hover:decoration-ink transition-colors">
          See what's included
        </a>
      </div>
      <p class="mt-6 text-sm text-mist">One-time payment · No recurring fees · Money-back guarantee</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-hairline py-16 md:py-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <p class="text-huge font-semibold text-ink">48 hours</p>
          <p class="mt-2 text-slate">From access to answers</p>
        </div>
        <div>
          <p class="text-huge font-semibold text-ink">Two decades</p>
          <p class="mt-2 text-slate">Of design experience</p>
        </div>
        <div>
          <p class="text-huge font-semibold text-ink">$997</p>
          <p class="mt-2 text-slate">Fixed price, no surprises</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What you receive -->
  <section id="whats-included" class="py-24 md:py-36">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="mb-16 md:mb-24">
        <p class="label mb-5">What you receive</p>
        <h2 class="text-huge font-semibold text-ink max-w-3xl">Everything you need to fix your site, in two business days.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-card border border-hairline p-10">
          <h3 class="text-2xl font-semibold text-ink mb-3">A recorded walkthrough</h3>
          <p class="text-slate leading-relaxed">
            I navigate your site as a first-time visitor, thinking out loud. You see exactly
            where the experience breaks down and why people leave.
          </p>
          <ul class="mt-5 space-y-1.5 text-sm text-slate">
            <li>20 to 30 minute screen recording</li>
            <li>Real-time first impressions</li>
            <li>Every confusion point called out</li>
          </ul>
        </div>

        <div class="bg-card border border-hairline p-10">
          <h3 class="text-2xl font-semibold text-ink mb-3">A prioritized list of fixes</h3>
          <p class="text-slate leading-relaxed">
            Every usability problem, accessibility gap, and design inconsistency, documented
            and ranked by how much it costs you.
          </p>
          <ul class="mt-5 space-y-1.5 text-sm text-slate">
            <li>Ranked critical to low priority</li>
            <li>Annotated screenshots</li>
            <li>Impact on conversions noted</li>
          </ul>
        </div>

        <div class="bg-card border border-hairline p-10">
          <h3 class="text-2xl font-semibold text-ink mb-3">Quick wins you can ship this week</h3>
          <p class="text-slate leading-relaxed">
            The low-effort, high-impact changes come first, so you start seeing results
            right away.
          </p>
          <ul class="mt-5 space-y-1.5 text-sm text-slate">
            <li>Specific implementation steps</li>
            <li>Estimated effort per item</li>
            <li>Ordered by payoff</li>
          </ul>
        </div>

        <div class="bg-card border border-hairline p-10">
          <h3 class="text-2xl font-semibold text-ink mb-3">A 60-minute strategy call</h3>
          <p class="text-slate leading-relaxed">
            We review the findings together, answer your questions, and leave with an action
            plan your team can run with.
          </p>
          <ul class="mt-5 space-y-1.5 text-sm text-slate">
            <li>Walkthrough of every finding</li>
            <li>Questions answered live</li>
            <li>A prioritization roadmap</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why it works -->
  <section class="border-y border-hairline py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="mb-16">
        <p class="label mb-5">Why it works</p>
        <h2 class="text-huge font-semibold text-ink max-w-3xl">Fast, fixed-price, and built to be acted on.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12 max-w-5xl">
        <div>
          <h3 class="text-xl font-semibold text-ink mb-2">Results in days, not months</h3>
          <p class="text-slate leading-relaxed">No waiting on an agency engagement. Critical issues identified and ready to fix in about two business days.</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-ink mb-2">A fraction of agency cost</h3>
          <p class="text-slate leading-relaxed">Senior insight for $997 instead of a five-figure agency audit. Same rigor, none of the overhead.</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-ink mb-2">Actionable, not academic</h3>
          <p class="text-slate leading-relaxed">No fluff or theory. Every recommendation includes specific steps your team can act on immediately.</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-ink mb-2">Two decades of experience</h3>
          <p class="text-slate leading-relaxed">The same judgment brought to PetSmart, Plexus, Green Compass, and dozens of other brands, focused on your site.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="py-24 md:py-36">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="mb-16">
        <p class="label mb-5">Who it's for</p>
        <h2 class="text-huge font-semibold text-ink max-w-3xl">Built for any site with a job to do.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-card border border-hairline p-10">
          <h3 class="text-xl font-semibold text-ink mb-3">Local and service businesses</h3>
          <p class="text-slate leading-relaxed">Your site should be producing calls and bookings. Find out exactly what's stopping it.</p>
        </div>
        <div class="bg-card border border-hairline p-10">
          <h3 class="text-xl font-semibold text-ink mb-3"><span class="whitespace-nowrap">E-commerce</span></h3>
          <p class="text-slate leading-relaxed">Find where carts get abandoned and checkouts stall, and recover the sales you're already close to.</p>
        </div>
        <div class="bg-card border border-hairline p-10">
          <h3 class="text-xl font-semibold text-ink mb-3">SaaS and startups</h3>
          <p class="text-slate leading-relaxed">Tighten onboarding, reduce churn, and validate your product with a senior outside read.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-hairline py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="mb-16">
        <p class="label mb-5">How it works</p>
        <h2 class="text-huge font-semibold text-ink max-w-3xl">Four steps from purchase to plan.</h2>
      </div>

      <div class="space-y-10 max-w-3xl">
        <div class="flex gap-6">
          <div class="w-12 h-12 bg-ink text-paper flex items-center justify-center text-xl font-semibold shrink-0">1</div>
          <div>
            <h3 class="text-xl font-semibold text-ink mb-2">Purchase and share access</h3>
            <p class="text-slate leading-relaxed">Complete your purchase and send access to your site: a URL for public sites, or a demo account for products behind a login.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="w-12 h-12 bg-ink text-paper flex items-center justify-center text-xl font-semibold shrink-0">2</div>
          <div>
            <h3 class="text-xl font-semibold text-ink mb-2">I conduct the audit</h3>
            <p class="text-slate leading-relaxed">Within two business days I evaluate your site end to end, record the walkthrough, document every issue, and compile the quick wins.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="w-12 h-12 bg-ink text-paper flex items-center justify-center text-xl font-semibold shrink-0">3</div>
          <div>
            <h3 class="text-xl font-semibold text-ink mb-2">You receive the full audit</h3>
            <p class="text-slate leading-relaxed">The video walkthrough, the prioritized list of fixes, and the recommendations document, all in one delivery.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="w-12 h-12 bg-ink text-paper flex items-center justify-center text-xl font-semibold shrink-0">4</div>
          <div>
            <h3 class="text-xl font-semibold text-ink mb-2">We talk strategy</h3>
            <p class="text-slate leading-relaxed">A 60-minute call to review the findings, answer your questions, and set your implementation roadmap.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-24 md:py-32">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <figure class="max-w-3xl mx-auto bg-card border border-hairline p-10 md:p-12">
        <blockquote class="text-xl text-ink leading-relaxed mb-8">
          &ldquo;Savelle is one of the most talented UX experts I've had the pleasure of working with. Within a very short period of time after his hire, he was knocking out work items and client side code. The impact of his effort and his work will be felt for a very long time.&rdquo;
        </blockquote>
        <figcaption>
          <div class="font-medium text-ink">Daniel Kruger</div>
          <div class="text-sm text-mist">VP of Software Development, SyberSafe</div>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-hairline py-24 md:py-32">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="mb-16">
        <p class="label mb-5">Questions, answered</p>
        <h2 class="text-huge font-semibold text-ink max-w-3xl">The details, up front.</h2>
      </div>
      <div class="max-w-3xl border-t border-hairline">
        {faqs.map((f) => (
          <div class="border-b border-hairline py-8">
            <h3 class="text-xl font-semibold text-ink mb-3">{f.question}</h3>
            <p class="text-slate leading-relaxed">{f.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-hairline py-24 md:py-32">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <h2 class="text-huge font-semibold text-ink max-w-3xl">Stop guessing at why your site isn't converting.</h2>
      <p class="mt-6 text-lg text-slate leading-relaxed max-w-2xl">
        The audit shows you exactly where visitors give up, and hands you the plan to fix it.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href={STRIPE_URL} class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors">
          Start your audit for $997
        </a>
      </div>
      <p class="mt-6 text-sm text-mist">48-hour delivery · Money-back guarantee · Strategy call included</p>
    </div>
  </section>

  <!-- Structured Data -->
  {pageSchema.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Fire begin_checkout when a visitor clicks through to the Stripe checkout,
       so paid-audit intent is measurable even though payment completes off-site. -->
  <script>
    document.querySelectorAll('a[href^="https://buy.stripe.com"]').forEach((el) => {
      el.addEventListener('click', () => {
        const gtag = (window as any).gtag;
        if (typeof gtag === 'function') {
          gtag('event', 'begin_checkout', {
            currency: 'USD',
            value: 997,
            items: [{ item_name: '48-Hour UX Audit', price: 997 }],
          });
        }
      });
    });
  </script>
</Layout>
