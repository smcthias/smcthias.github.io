---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = (Astro.site || 'https://savelledesign.com').toString().replace(/\/$/, '');

// FAQ schema is derived from the on-page Q&As below — keep the two in sync.
const faqs = [
  {
    question: 'Do you design the emails, or also send them?',
    answer:
      'I design and build the templates — layout, structure, and responsive HTML that renders across clients. Sending, lists, and automation live in your email platform; I build to work cleanly with it and hand off files you can reuse.',
  },
  {
    question: 'Which email platforms do you work with?',
    answer:
      "The common ones — Mailchimp, Klaviyo, ActiveCampaign, HubSpot, and similar. Tell me what you're on and I'll build templates that drop in without breaking on the way to the inbox.",
  },
  {
    question: 'Will the emails look right on phones and in dark mode?',
    answer:
      "Yes. Most email gets opened on a phone, so I design mobile-first and test across major clients, including dark mode, before handing anything off. Email that only works in one inbox isn't finished.",
  },
  {
    question: 'Can you match my brand?',
    answer:
      "That's the point. Your email should read as the same company as your website — same voice, same look. If your brand identity is inconsistent, this is a good moment to tighten it.",
  },
  {
    question: 'How much does an email campaign cost?',
    answer:
      'It depends on how many templates you need and how much design and copy is involved. You will find ranges on the pricing page; we set a fixed scope and price before starting.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Email Campaign Design',
    serviceType: 'Email Campaign Design',
    description:
      'Designed, responsive email templates built to match your brand and render across major email clients, including dark mode.',
    url: `${siteUrl}/services/email-campaigns`,
    provider: { '@type': 'Person', name: 'Savelle McThias' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<Layout title="Email Campaign Design - Savelle Design" description="Design engaging email campaigns that connect with your audience and drive action.">
    <!-- Hero Section -->
    <section class="py-20 md:py-28">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <a href={`${base}/services`} class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors mb-10">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to services
      </a>
      <p class="spec-label mb-4" data-reveal>Email campaigns</p>
      <h1 class="font-display text-mega text-paper max-w-4xl" data-reveal>
        Emails people actually <span class="bracketed">open</span> — designed to convert.
      </h1>
      <p class="mt-8 text-lg md:text-xl text-muted max-w-3xl leading-relaxed" data-reveal>
        Templates built to look like your brand, render cleanly in every inbox, and give readers one clear reason to act.
      </p>
      <a href={`${base}/pricing`} class="mt-8 inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors" data-reveal>
        View pricing
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      </div>
    </section>

    <!-- Service Overview -->
    <section class="py-24 md:py-28 bg-surface border-y border-line">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="min-w-0" data-reveal>
          <h2 class="text-huge font-display text-paper mb-6">Why email still matters</h2>
          <p class="text-lg text-muted mb-6 leading-relaxed">
            Email is still one of the few channels where you reach your audience directly, on your terms. A well-built campaign nurtures leads, drives sales, and keeps customers coming back.
          </p>
          <p class="text-lg text-muted leading-relaxed">
            You get email that looks professional, renders across every device, and guides the reader toward the action you care about.
          </p>
        </div>
        <div class="aspect-[4/3] rounded-[2px] overflow-hidden border border-line" data-reveal data-reveal-delay="80">
          <img src={`${base}/images/works/yoli-detail3.png`} alt="Email Campaign Design Example" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
      </div>
    </section>

    <!-- What's Included -->
    <section class="py-24 md:py-32">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
        <p class="spec-label mb-4" data-reveal>What's included</p>
        <h2 class="text-huge font-display text-paper mb-16 max-w-2xl" data-reveal>Built to land in the inbox.</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Custom templates', body: 'Branded email designs that hold together across every email client and device.' },
          { title: 'Campaign strategy', body: 'Guidance on frequency, content, and what tends to work for your audience.' },
          { title: 'Mobile-responsive', body: 'Email that looks right whether it opens on a phone, a tablet, or a laptop.' },
          { title: 'Series design', body: 'Welcome sequences, nurture flows, and promo series with one cohesive look.' },
          { title: 'Clear call-to-actions', body: 'Buttons and links designed to move the reader toward a single next step.' },
          { title: 'Platform integration', body: 'Templates that drop cleanly into Mailchimp, Klaviyo, ConvertKit, and the rest.' },
        ].map((item, i) => (
          <div class="rounded-[2px] border border-line bg-surface p-8 min-w-0" data-reveal data-reveal-delay={i * 60}>
            <h3 class="text-xl font-display text-paper mb-3">{item.title}</h3>
            <p class="text-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-24 md:py-28 bg-surface border-y border-line">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
        <p class="spec-label mb-4" data-reveal>Perfect for</p>
        <h2 class="text-huge font-display text-paper mb-16 max-w-2xl" data-reveal>Where email earns its keep.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Product launches', body: 'Build anticipation and drive sales with a launch sequence that looks the part.' },
          { title: 'Newsletters', body: 'Keep your audience close with regular updates, tips, and content worth opening.' },
          { title: 'Welcome series', body: 'Make a strong first impression with new subscribers and guide them to engage.' },
        ].map((item, i) => (
          <div class="rounded-[2px] border border-line bg-ink p-8 min-w-0" data-reveal data-reveal-delay={i * 60}>
            <h3 class="text-xl font-display text-paper mb-3">{item.title}</h3>
            <p class="text-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 md:py-32">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
        <p class="spec-label mb-4 text-center" data-reveal>FAQ</p>
        <h2 class="text-huge font-display text-paper mb-12 text-center" data-reveal>Frequently asked questions</h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((f, i) => (
            <details class="group rounded-[2px] border border-line bg-surface p-6 md:p-8 open:border-line-2" data-reveal data-reveal-delay={i * 40}>
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <h3 class="text-lg font-display text-paper group-hover:text-accent transition-colors">{f.question}</h3>
                <svg class="w-5 h-5 shrink-0 text-faint group-open:rotate-45 group-hover:text-accent transition-all mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"/></svg>
              </summary>
              <p class="text-muted leading-relaxed mt-4">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 md:py-28 bg-surface border-t border-line">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
        <div class="max-w-3xl mx-auto text-center" data-reveal>
          <h2 class="text-huge font-display text-paper mb-6">
            Ready for email that gets results?
          </h2>
          <p class="text-lg md:text-xl text-muted mb-8 leading-relaxed">
            Tell me what you're sending and I'll build templates your audience looks forward to.
          </p>
          <a
            href={`${base}/contact`}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-[2px] bg-accent text-ink font-medium hover:bg-accent-dim transition-colors"
          >
            Start a project
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>
    </section>

  <!-- Structured Data -->
  {pageSchema.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</Layout>
