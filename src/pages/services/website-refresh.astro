---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = (Astro.site || 'https://savelledesign.com').toString().replace(/\/$/, '');

// FAQ schema is derived from the on-page Q&As below. Keep the two in sync.
const faqs = [
  {
    question: "What's the difference between a refresh and a full rebuild?",
    answer:
      'A refresh keeps what is working: your structure, your content, your platform. It modernizes the look, the layout, and the parts that frustrate visitors. A rebuild starts over. Most businesses need a refresh, not a teardown, and we will figure out which on the first call.',
  },
  {
    question: 'Will a redesign hurt my Google rankings?',
    answer:
      'Not when it is done carefully. I preserve your URLs, keep your content intact, and set up redirects for anything that moves, so the search equity you have built comes with you. A good redesign helps findability. It does not reset it.',
  },
  {
    question: 'Can you work with my existing website platform?',
    answer:
      "Usually, yes: WordPress, Squarespace, Webflow, Shopify, and most common setups. If your current platform is holding you back, I'll tell you plainly and lay out the tradeoffs before you commit to a move.",
  },
  {
    question: 'How do I know my site actually needs work?',
    answer:
      'Take the Website Score. Ten questions, an instant read on how well your site turns visitors into paying customers, and your three highest-priority fixes. For a hands-on review of a live site, the 48-Hour UX Audit pinpoints what is costing you conversions.',
  },
  {
    question: 'How much does a website refresh cost?',
    answer:
      'It comes down to how many pages change and how much new design and content is involved. Ranges are on the pricing page, and we agree on a fixed scope and price before I start.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Website Refresh & Redesign',
    serviceType: 'Website Redesign',
    description:
      'A website redesign that modernizes structure, visuals, and content while preserving the search equity you have already built.',
    url: `${siteUrl}/services/website-refresh`,
    provider: { '@type': 'Person', name: 'Savelle McThias' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];

const included = [
  { title: 'Website audit', body: 'A review of your current site to pin down what is working and what is quietly costing you.' },
  { title: 'Modern design', body: 'A current look that fits your brand instead of chasing a trend.' },
  { title: 'Improved navigation', body: 'A simpler structure so visitors find what they need without hunting for it.' },
  { title: 'Mobile optimization', body: 'Looks right and works right on phones and tablets, where most people arrive.' },
  { title: 'Performance boost', body: 'Faster load times that keep visitors engaged and help your search rankings.' },
  { title: 'Content strategy', body: 'Guidance on sharpening your messaging so it connects with your audience.' },
];

const fits = [
  { title: 'The business has outgrown the site', body: 'What you sell has evolved, and the site should reflect where you are now.' },
  { title: 'The design shows its age', body: 'It was built years ago and looks it, especially next to your competitors.' },
  { title: 'The site works against visitors', body: 'It is slow, hard to use, or falls apart on a phone.' },
];
---

<Layout title="Website Refresh & Redesign - Savelle Design" description="Modernize your website with a fresh design that better represents your brand and engages your audience.">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="pt-16 md:pt-28 pb-16 md:pb-24">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <a href={`${base}/services`} class="inline-flex items-center gap-2 text-sm text-mist hover:text-ink transition-colors mb-10">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to services
      </a>
      <p class="label mb-5">Website refresh</p>
      <h1 class="font-semibold text-mega text-ink max-w-[20ch]">
        Keep what works, fix what fails, ship a site that sells.
      </h1>
      <p class="mt-10 max-w-2xl text-lg md:text-xl text-slate leading-relaxed">
        A refresh gives your site a modern look, a cleaner path through it, and
        better results, without tearing everything down and starting over.
      </p>
      <a href={`${base}/pricing`} class="mt-8 inline-block text-ink font-medium underline underline-offset-8 decoration-hairline hover:decoration-ink transition-colors">
        View pricing
      </a>
    </div>
  </section>

  <!-- ── The case for a refresh ───────────────────────────────────────── -->
  <section class="border-y border-hairline py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="min-w-0 lg:col-span-6">
          <h2 class="text-huge font-semibold text-ink">The case for a refresh</h2>
          <p class="mt-6 text-lg text-slate leading-relaxed max-w-xl">
            Your website is often the first place a potential customer meets your
            business. If it looks dated, is hard to use, or falls apart on a
            phone, you are losing people who would have bought.
          </p>
          <p class="mt-6 text-lg text-slate leading-relaxed max-w-xl">
            A refresh sharpens how your brand reads, makes it easier for customers
            to find what they came for, and moves the number that matters, all
            without starting from scratch. AI-integrated workflows keep the whole
            thing fast, with one senior designer accountable for the result.
          </p>
        </div>
        <div class="min-w-0 lg:col-span-6">
          <div class="overflow-hidden bg-card border border-hairline">
            <img src={`${base}/images/works/nikkl-detail3.png`} alt="Website refresh and redesign example" class="w-full aspect-[4/3] object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What's included ──────────────────────────────────────────────── -->
  <section class="py-24 md:py-36">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">What's included</p>
      <h2 class="text-huge font-semibold text-ink max-w-3xl mb-14 md:mb-20">A tune-up, not a teardown.</h2>
      <div>
        {included.map((item) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 border-t border-hairline py-6">
            <h3 class="min-w-0 md:col-span-4 text-lg font-semibold text-ink">{item.title}</h3>
            <p class="min-w-0 md:col-span-8 text-slate leading-relaxed max-w-2xl">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── When a refresh is the right call ─────────────────────────────── -->
  <section class="border-y border-hairline py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">A good fit when</p>
      <h2 class="text-huge font-semibold text-ink max-w-3xl mb-14 md:mb-16">When a refresh is the right call.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10">
        {fits.map((item) => (
          <div class="min-w-0 border-t border-hairline pt-6">
            <h3 class="text-xl font-semibold text-ink mb-2">{item.title}</h3>
            <p class="text-slate leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── See it in practice ───────────────────────────────────────────── -->
  <section class="py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">See it in practice</p>
      <a href={`${base}/works/lamesa`} class="group block border border-hairline bg-card p-10 md:p-12 hover:border-ink transition-colors">
        <h3 class="text-2xl font-semibold text-ink mb-2">La Mesa RV &amp; Van Up</h3>
        <p class="text-slate leading-relaxed max-w-2xl">
          11 RV dealerships pulled into one inventory customers could actually
          search, without throwing out the platform underneath.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 font-medium text-ink">View the project <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
      </a>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="border-t border-hairline py-20 md:py-28">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <p class="label mb-5">FAQ</p>
      <h2 class="text-huge font-semibold text-ink max-w-3xl mb-14">Questions, answered.</h2>
      <div class="max-w-3xl space-y-4">
        {faqs.map((f) => (
          <details class="group border border-hairline bg-card p-6 md:p-8">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <h3 class="text-lg font-semibold text-ink">{f.question}</h3>
              <svg class="w-5 h-5 shrink-0 text-mist group-open:rotate-45 transition-transform mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="text-slate leading-relaxed mt-4">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Closing ──────────────────────────────────────────────────────── -->
  <section class="border-t border-hairline py-24 md:py-32">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <h2 class="text-huge font-semibold text-ink max-w-3xl">Let's talk about your project.</h2>
      <div class="mt-10">
        <a href={`${base}/contact`} class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-paper font-medium hover:bg-ink/85 transition-colors">
          Start your project
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Structured Data -->
  {pageSchema.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</Layout>
