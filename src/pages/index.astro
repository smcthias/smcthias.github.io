---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Reel from '../components/Reel.astro';
import { FEATURED } from '../data/featured';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = await getCollection('projects');
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
const work = FEATURED.slice(0, 4).map((f) => byId[f.slug]);

// One uniform box per logo (not a per-logo custom height) — equal visual
// weight regardless of each mark's native aspect ratio, and guarantees
// consistent gaps in the marquee (mismatched heights were crowding/
// colliding against neighbors).
const logos = [
  { src: '/images/logos/logo-petsmart.svg', alt: 'PetSmart' },
  { src: '/images/logos/logo-gm.svg', alt: 'General Motors' },
  { src: '/images/logos/logo-sothebys.svg', alt: "Sotheby's" },
  { src: '/images/logos/logo-universal.svg', alt: 'Universal' },
  { src: '/images/logos/logo-capitolrecords.svg', alt: 'Capitol Records' },
  { src: '/images/logos/logo-lamesa.svg', alt: 'La Mesa RV' },
  { src: '/images/logos/logo-plexus.svg', alt: 'Plexus Worldwide' },
  { src: '/images/logos/logo-bareminerals.svg', alt: 'bareMinerals' },
  { src: '/images/logos/logo-thebeachboys.svg', alt: 'The Beach Boys' },
  { src: '/images/logos/logo-richdad.svg', alt: 'Rich Dad' },
  { src: '/images/logos/logo-sanity.svg', alt: 'Sanity' },
];

const pillars = [
  { name: 'Web', items: ['Conversion.', 'Ecommerce.', 'Mobile.', 'Speed.'] },
  { name: 'Brand', items: ['Identity.', 'Voice.', 'Logo.', 'Feel.'] },
  { name: 'Reach', items: ['Inbox.', 'Social.', 'Campaigns.', 'Engagement.'] },
];

---

<Layout
  title="Savelle Design - Websites That Turn Visitors Into Customers"
  description="Design and development that turns visitors into customers. Two decades of experience, AI-integrated workflows, and senior execution for startups, agencies, and enterprise marketing teams."
>
  <!-- ── Hero: full viewport height on desktop. The headline sits in-flow
       at the top, lining up visually between the wordmark and the nav
       buttons without being part of Nav.astro itself. md:-mt-[138px]
       cancels Layout's md:pt-[138px] (nav clearance, nav is now
       padding-driven at 48px rather than a fixed h-20) so this section
       starts flush at the top of the page — auto-height padding (not a
       fixed row) keeps the two-line headline from overflowing past the
       viewport edge. ── -->
  <section class="relative bg-zinc-950 md:-mt-[138px] md:h-screen md:flex md:flex-col">
    <div class="pt-24 pb-8 md:pt-12 md:pb-12 md:shrink-0 px-5 sm:px-8 md:px-12">
      <h1
        data-word-reveal
        data-word-reveal-speed="slow"
        class="font-sans font-normal text-5xl text-white md:w-fit md:mx-auto md:text-left"
      >
        Design is the first thing<br />your customers trust.
      </h1>
    </div>

    <!-- Showreel: ambient muted loop. Hover reveals a "Play Showreel"
         affordance; clicking anywhere opens the full-sound lightbox. -->
    <div class="mt-8 md:mt-0 md:flex-1 md:min-h-0 px-5 sm:px-8 md:px-12">
      <button
        data-reel-play
        class="group relative block w-full aspect-[16/10] sm:aspect-[21/9] md:aspect-auto md:h-full rounded-2xl md:rounded-3xl overflow-hidden cursor-pointer bg-zinc-900"
        aria-label="Play the portfolio showreel with sound"
      >
        <Reel />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        <div class="absolute inset-0 flex items-center justify-center gap-5 md:gap-6 bg-black/0 group-hover:bg-black/40 transition-colors duration-300">
          <span class="text-white text-xl md:text-2xl font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Play
          </span>
          <span class="inline-flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-full bg-white text-zinc-950 scale-75 group-hover:scale-100 opacity-0 group-hover:opacity-100 transition-all duration-300">
            <svg class="w-6 h-6 md:w-7 md:h-7 ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="text-white text-xl md:text-2xl font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Showreel
          </span>
        </div>
      </button>
    </div>

    <div class="mt-12 md:shrink-0 md:pb-8 px-5 sm:px-8 md:px-12 flex items-center justify-center gap-4 text-zinc-600">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 5v14M6 13l6 6 6-6" /></svg>
      <span class="text-xs font-medium tracking-[0.2em] uppercase">Scroll</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 5v14M6 13l6 6 6-6" /></svg>
    </div>
  </section>

  <!-- ── Services opener: headline top-left, subtext bottom-right ────────
       The subtext fades in only once the headline's word-reveal finishes
       (data-reveal-next chains it, see src/scripts/word-reveal.ts) rather
       than animating in alongside it. ── -->
  <section class="bg-zinc-950 pt-20 md:pt-28 pb-14 md:pb-16 md:min-h-[560px] md:flex md:flex-col md:justify-between">
    <div class="px-5 sm:px-8 md:px-12">
      <h2
        data-word-reveal
        data-reveal-next="#opener-subtext"
        class="font-head text-huge md:text-9xl font-normal text-white"
      >
        Trust is built<br />in seconds.
      </h2>
    </div>
    <div class="mt-8 md:mt-16 px-5 sm:px-8 md:px-12 md:flex md:justify-end max-w-7xl">
      <p id="opener-subtext" data-fade-reveal class="max-w-md text-lg md:text-4xl text-zinc-400">
        I make sure it holds. AI runs through my process, the craft stays mine.
      </p>
    </div>
  </section>

  <!-- ── Web / Brand / Reach pillars ──────────────────────────────────── -->
  <!-- Mobile: plain stacked column. Desktop: gsap ScrollTrigger pins this
       section and converts vertical scroll into horizontal movement across
       the three cards (src/scripts/pillar-scroll.ts) — the one deliberate
       scroll-hijack exception, contained to this section only. Falls back
       to the stacked layout under prefers-reduced-motion or if JS never
       runs, since .pillar-track only gets flex-direction:row from the
       is-horizontal class the script adds. The logo strip lives inside
       this section (not a separate one after it) so it stays pinned at
       the bottom of the viewport for the whole horizontal-scroll pin,
       underneath the cards, rather than only appearing once it ends. -->
  <section id="pillars-section" class="relative bg-zinc-950 md:h-screen md:overflow-hidden md:flex md:flex-col">
    <div class="relative md:flex-1 md:min-h-0">
      <div data-pillar-track class="pillar-track flex flex-col">
        {pillars.map((p) => (
          <div data-pillar-card class="shrink-0 w-full md:w-[85vw] flex flex-col md:flex-row items-center gap-8 md:gap-16 px-5 sm:px-8 md:px-12 py-16 md:py-0">
            <div class="w-full md:w-1/2 aspect-[4/3] rounded-2xl bg-zinc-800 flex items-center justify-center text-zinc-600 text-sm shrink-0">
              {p.name} visual
            </div>
            <div class="w-full md:w-1/2">
              <h2 class="font-head text-huge md:text-8xl font-normal text-white">{p.name}</h2>
              <ul class="mt-6 space-y-6 text-xl md:text-4xl text-white">
                {p.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Affordance: arrows + progress dots (desktop, once the pin is active).
           Starts hidden via inline style (not the `hidden` attribute) since it
           also carries `flex` — see CLAUDE.md's Preflight [hidden] gotcha. -->
      <div class="items-center justify-center gap-6 px-5 sm:px-8 md:px-12 z-10 pillar-controls absolute inset-x-0 bottom-6" style="display:none">
        <button type="button" data-pillar-prev aria-label="Previous pillar" class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-zinc-700 text-white hover:bg-zinc-900 transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 18l-6-6 6-6" /></svg>
        </button>
        <div class="flex gap-2" data-pillar-dots aria-hidden="true">
          {pillars.map((_, i) => <span class={`w-6 h-1 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-zinc-700'}`}></span>)}
        </div>
        <button type="button" data-pillar-next aria-label="Next pillar" class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-zinc-700 text-white hover:bg-zinc-900 transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>

      <!-- Affordance: scroll-sideways hint, shown before the user scrolls (desktop only, JS toggles it off on first progress) -->
      <p class="pillar-hint absolute right-8 bottom-6 z-10 text-xs font-medium text-zinc-500 uppercase tracking-[0.2em]" style="display:none">
        Keep scrolling →
      </p>
    </div>

    <!-- Logo strip: pinned at the bottom of the viewport underneath the
         cards, endlessly scrolling, full set of logos (no truncation). -->
    <div class="md:shrink-0 border-t border-zinc-900 pt-6 pb-8 md:pt-5 md:pb-5 overflow-hidden">
      <p class="text-center text-xs font-medium text-zinc-500 uppercase tracking-[0.2em] mb-5">
        Trusted by brands you know
      </p>
      <div class="marquee" aria-label="Client brands">
        <div class="marquee-track">
          {logos.map(({ src, alt }) => (
            <img src={`${base}${src}`} alt={alt} class="h-9 md:h-11 w-28 md:w-32 shrink-0 object-contain brightness-0 invert opacity-60" loading="lazy" />
          ))}
        </div>
        <div class="marquee-track" aria-hidden="true">
          {logos.map(({ src }) => (
            <img src={`${base}${src}`} alt="" class="h-9 md:h-11 w-28 md:w-32 shrink-0 object-contain brightness-0 invert opacity-60" loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Case studies: 2x2 grid, per the comp ─────────────────────────── -->
  <section class="bg-zinc-950">
    <div class="px-5 sm:px-8 md:px-12 py-24 md:py-36">
      <div class="mb-16 md:mb-20">
        <h2 data-word-reveal class="font-head text-huge md:text-9xl font-normal text-white">The work speaks first.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16">
        {work.map((p) => (
          <a href={`${base}/works/${p.id}`} class="group block min-w-0">
            <div class="overflow-hidden rounded-2xl bg-zinc-900">
              <img
                src={`${base}/images/works/${p.data.thumbnail}`}
                alt={`${p.data.title}, ${p.data.category}`}
                class="w-full aspect-[4/3] object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                loading="lazy"
              />
            </div>
            <p class="mt-5 md:text-xl font-medium text-zinc-50 uppercase">
              {p.data.tags.join(' • ')}
            </p>
            <h3 class="mt-2 font-head text-2xl md:text-5xl font-normal text-white">{p.data.title}</h3>
          </a>
        ))}
      </div>

      <div class="mt-16 md:mt-20 md:text-center">
        <a href={`${base}/works`} class="inline-flex items-center gap-3 text-xl md:text-6xl font-normal text-white hover:text-zinc-400 transition-colors">
          More projects
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
