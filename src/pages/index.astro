---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Reel from '../components/Reel.astro';
import ReelLightbox from '../components/ReelLightbox.astro';
import { FEATURED } from '../data/featured';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = await getCollection('projects');
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
const work = FEATURED.slice(0, 3).map((f) => ({
  ...byId[f.slug],
  stat: f.stat,
  statLabel: f.statLabel,
  hook: f.hook,
}));

const logos = [
  { src: '/images/logos/logo-petsmart.svg', alt: 'PetSmart', h: 'h-[38px]' },
  { src: '/images/logos/logo-gm.svg', alt: 'General Motors', h: 'h-[52px]' },
  { src: '/images/logos/logo-sothebys.svg', alt: "Sotheby's", h: 'h-[30px]' },
  { src: '/images/logos/logo-universal.svg', alt: 'Universal', h: 'h-[52px]' },
  { src: '/images/logos/logo-capitolrecords.svg', alt: 'Capitol Records', h: 'h-[52px]' },
  { src: '/images/logos/logo-lamesa.svg', alt: 'La Mesa RV', h: 'h-[38px]' },
  { src: '/images/logos/logo-plexus.svg', alt: 'Plexus Worldwide', h: 'h-[44px]' },
  { src: '/images/logos/logo-bareminerals.svg', alt: 'bareMinerals', h: 'h-[22px]' },
  { src: '/images/logos/logo-thebeachboys.svg', alt: 'The Beach Boys', h: 'h-[52px]' },
  { src: '/images/logos/logo-richdad.svg', alt: 'Rich Dad', h: 'h-[22px]' },
  { src: '/images/logos/logo-sanity.svg', alt: 'Sanity', h: 'h-[30px]' },
];

const services = [
  {
    title: 'Landing Pages',
    line: 'One page with one job: turn a click into a customer.',
    art: 'browser',
  },
  {
    title: 'Website Refresh',
    line: 'Keep what works, fix what fails, ship a site that sells.',
    art: 'layers',
  },
  {
    title: 'Brand Identity',
    line: 'A consistent look your whole team can actually keep consistent.',
    art: 'mark',
  },
  {
    title: 'Email Campaigns',
    line: 'Email people open, read, and act on.',
    art: 'cards',
  },
];
---

<Layout
  title="Savelle Design - Websites That Turn Visitors Into Customers"
  description="Design and development that turns visitors into customers. Two decades of experience, AI-integrated workflows, and senior execution for startups, agencies, and enterprise marketing teams."
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative">
    <p class="edge-label absolute right-5 sm:right-8 top-10 hidden lg:block" aria-hidden="true">
      UX &amp; Web Design · Scottsdale, AZ
    </p>
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8 pt-16 md:pt-28 pb-16 md:pb-24">
      <h1 class="font-semibold text-mega text-ink max-w-[17ch]">
        I design and build websites that turn visitors into customers.
      </h1>
    </div>
  </section>

  <!-- ── Showreel: full-bleed, already playing ────────────────────────── -->
  <section class="bg-ink">
    <button
      data-reel-play
      class="group relative block w-full h-[70vh] min-h-[420px] overflow-hidden cursor-pointer"
      aria-label="Play the portfolio showreel with sound"
    >
      <Reel />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-transparent to-transparent"></div>
      <span class="absolute left-5 sm:left-8 bottom-6 text-sm text-paper/90">Showreel 2026</span>
      <span class="absolute right-5 sm:right-8 bottom-6 inline-flex items-center gap-2.5 text-sm text-paper border border-paper/40 px-4 py-2 group-hover:bg-paper group-hover:text-ink transition-colors">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        Play with sound
      </span>
    </button>
  </section>

  <!-- ── Trusted by ───────────────────────────────────────────────────── -->
  <section class="border-b border-hairline py-14 md:py-16 overflow-hidden">
    <div class="marquee" aria-label="Client brands">
      <div class="marquee-track">
        {logos.map(({ src, alt, h }) => (
          <img src={`${base}${src}`} alt={alt} class={`${h} w-auto object-contain brightness-0 opacity-70`} loading="lazy" />
        ))}
      </div>
      <div class="marquee-track" aria-hidden="true">
        {logos.map(({ src, h }) => (
          <img src={`${base}${src}`} alt="" class={`${h} w-auto object-contain brightness-0 opacity-70`} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Selected work: dark gallery, each project gets its moment ────── -->
  <section class="bg-ink text-paper on-dark">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8 py-24 md:py-36">
      <div class="mb-20 md:mb-28">
        <h2 class="text-huge font-semibold max-w-3xl">Real problems. Real results.</h2>
      </div>

      <div class="space-y-24 md:space-y-36">
        {work.map((p, i) => (
          <a href={`${base}/works/${p.id}`} class="group grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
            <div class={`min-w-0 lg:col-span-8 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div class="overflow-hidden bg-ink-soft">
                <img
                  src={`${base}/images/works/${p.data.thumbnail}`}
                  alt={`${p.data.title}, ${p.data.category}`}
                  class="w-full aspect-[16/10] object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>
            </div>
            <div class={`min-w-0 lg:col-span-4 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              <p class="text-mega font-semibold text-paper leading-none">{p.stat}</p>
              <p class="text-fog mt-2">{p.statLabel}</p>
              <p class="mt-8 text-lg text-paper leading-snug max-w-sm">{p.hook}</p>
              <p class="mt-6 text-sm text-dusk">{p.data.title} · {p.data.category}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm text-paper underline underline-offset-8 decoration-seam group-hover:decoration-paper transition-colors">
                View project
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-24 md:mt-32 border-t border-seam pt-10">
        <a href={`${base}/works`} class="inline-flex items-center gap-3 text-2xl md:text-3xl font-semibold text-paper hover:text-fog transition-colors">
          View all work
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── What I do: two at a time, room to breathe ────────────────────── -->
  <section class="py-24 md:py-36">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8">
      <div class="mb-16 md:mb-24">
        <h2 class="text-huge font-semibold text-ink max-w-3xl">Four services. One standard of craft.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-20 md:gap-y-28">
        {services.map((s) => (
          <div class="block min-w-0">
            <div class="aspect-[16/9] bg-card border border-hairline flex items-center justify-center mb-8 overflow-hidden">
              <svg class="w-40 h-40 text-mist" viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                {s.art === 'browser' && (
                  <g transform="translate(80 84) scale(1 0.55) rotate(-30)">
                    <rect x="-44" y="-44" width="88" height="88" />
                    <line x1="-44" y1="-26" x2="44" y2="-26" />
                    <rect x="-32" y="-12" width="40" height="10" />
                    <rect x="-32" y="6" width="64" height="6" />
                    <rect x="-32" y="18" width="52" height="6" />
                    <rect x="-32" y="32" width="24" height="10" />
                  </g>
                )}
                {s.art === 'layers' && (
                  <g transform="translate(80 80)">
                    <g transform="scale(1 0.55) rotate(-30)"><rect x="-40" y="-40" width="80" height="80" /></g>
                    <g transform="translate(0 -22) scale(1 0.55) rotate(-30)"><rect x="-40" y="-40" width="80" height="80" /></g>
                    <g transform="translate(0 -44) scale(1 0.55) rotate(-30)"><rect x="-40" y="-40" width="80" height="80" /></g>
                  </g>
                )}
                {s.art === 'mark' && (
                  <g transform="translate(80 80)">
                    <circle cx="0" cy="0" r="44" />
                    <circle cx="0" cy="0" r="24" />
                    <line x1="-56" y1="0" x2="56" y2="0" />
                    <line x1="0" y1="-56" x2="0" y2="56" />
                  </g>
                )}
                {s.art === 'cards' && (
                  <g transform="translate(80 88) scale(1 0.55) rotate(-30)">
                    <rect x="-48" y="-32" width="64" height="44" />
                    <g transform="translate(14 -14)"><rect x="-48" y="-32" width="64" height="44" /></g>
                    <g transform="translate(28 -28)">
                      <rect x="-48" y="-32" width="64" height="44" />
                      <line x1="-48" y1="-32" x2="-16" y2="-6" />
                      <line x1="16" y1="-32" x2="-16" y2="-6" />
                    </g>
                  </g>
                )}
              </svg>
            </div>
            <h3 class="text-big font-semibold text-ink">{s.title}</h3>
            <p class="mt-3 text-lg text-slate leading-relaxed max-w-md">{s.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── How I work: the AI advantage, stated plainly ─────────────────── -->
  <section class="border-y border-hairline">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-8 py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <div class="min-w-0 lg:col-span-7">
          <h2 class="text-huge font-semibold text-ink max-w-[18ch]">AI in the workflow. A senior designer at the wheel.</h2>
        </div>
        <div class="min-w-0 lg:col-span-5 flex flex-col justify-end gap-6">
          <p class="text-lg text-slate leading-relaxed">
            I work alongside AI at every step, from research to build. It gives you the
            speed of a full team with the judgment of one accountable senior designer.
            The result is better work, delivered faster, at a budget that flexes to fit.
          </p>
          <a href={`${base}/about`} class="text-ink font-medium underline underline-offset-8 decoration-hairline hover:decoration-ink transition-colors self-start">
            More about how I work
          </a>
        </div>
      </div>
    </div>
  </section>

  <ReelLightbox />
</Layout>
