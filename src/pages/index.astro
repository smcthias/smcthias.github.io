---
import Layout from '../layouts/Layout.astro';
import Reel from '../components/Reel.astro';
import Gallery from '../components/Gallery.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');


// One uniform box per logo (not a per-logo custom height) — equal visual
// weight regardless of each mark's native aspect ratio, and guarantees
// consistent gaps in the marquee (mismatched heights were crowding/
// colliding against neighbors).
const logos = [
  { src: '/images/logos/logo-petsmart.svg', alt: 'PetSmart' },
  { src: '/images/logos/logo-gm.svg', alt: 'General Motors' },
  { src: '/images/logos/logo-sothebys.svg', alt: "Sotheby's" },
  { src: '/images/logos/logo-universal.svg', alt: 'Universal' },
  { src: '/images/logos/logo-capitolrecords.svg', alt: 'Capitol Records' },
  { src: '/images/logos/logo-lamesa.svg', alt: 'La Mesa RV' },
  { src: '/images/logos/logo-plexus.svg', alt: 'Plexus Worldwide' },
  { src: '/images/logos/logo-bareminerals.svg', alt: 'bareMinerals' },
  { src: '/images/logos/logo-thebeachboys.svg', alt: 'The Beach Boys' },
  { src: '/images/logos/logo-richdad.svg', alt: 'Rich Dad' },
  { src: '/images/logos/logo-sanity.svg', alt: 'Sanity' },
];

---

<Layout
  title="Savelle Design - Websites That Turn Visitors Into Customers"
  description="Design and development that turns visitors into customers. Two decades of experience, AI-integrated workflows, and senior execution for startups, agencies, and enterprise marketing teams."
>
  <!-- Interactive dot grid backdrop (src/scripts/dot-grid.ts): fixed,
       behind everything. The hero's video covers it; the gallery section is
       transparent so the dots show through behind the tiles (no fade trigger,
       so it stays visible for the whole page). The hero's video fully covers it, so it first
       becomes visible once the hero scrolls away. pointer-events-none so it
       never intercepts clicks. -->
  <canvas id="dot-grid-canvas" class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true"></canvas>

  <!-- ── Hero: exactly one viewport (100svh, not vh, so mobile browser bars
       can't cut off the logo band). The looping reel covers the whole area,
       the fixed nav floats over it, the Play pill is the only thing in the
       middle, and the logo marquee sits on a dark translucent strip at the
       bottom edge. -mt-16 / md:-mt-[138px] cancel Layout's <main> nav-
       clearance padding so the hero starts flush at the top of the page. ── -->
  <section class="relative -mt-16 md:-mt-[138px] h-[100svh] overflow-hidden bg-zinc-950">
    <div data-image-reveal data-image-reveal-duration="1.4" data-image-reveal-delay="0.2" class="absolute inset-0">
      <Reel />
      <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <!-- Only the pill opens the lightbox (full-sound Vimeo, loaded on click). -->
    <div class="absolute inset-0 flex items-center justify-center">
      <!-- data-play-zone: transparent 80px halo around the pill; the magnetic
           pull is only tracked while the pointer is inside it. -->
      <div data-play-zone class="p-20">
      <button
        data-reel-play
        data-play-btn
        class="play-btn group inline-flex items-center gap-3 md:gap-4 rounded-full bg-white text-zinc-950 cursor-pointer pl-3 pr-7 py-3 md:pl-4 md:pr-9 md:py-4 text-base md:text-xl font-medium"
        aria-label="Play the portfolio showreel with sound"
      >
        <span class="inline-flex items-center justify-center w-11 h-11 md:w-14 md:h-14 rounded-full bg-zinc-950 text-white transition-transform duration-300 group-hover:scale-105">
          <svg class="w-4 h-4 md:w-5 md:h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </span>
        Play showreel
      </button>
      </div>
    </div>

    <!-- Logo band: translucent black strip, white logos at 60%, slow marquee. -->
    <div class="absolute inset-x-0 bottom-0 bg-black/60 py-5 md:py-6 overflow-hidden">
      <div class="marquee" aria-label="Client brands">
        <div class="marquee-track">
          {logos.map(({ src, alt }) => (
            <img src={`${base}${src}`} alt={alt} class="h-9 md:h-11 w-28 md:w-32 shrink-0 object-contain brightness-0 invert opacity-60" />
          ))}
        </div>
        <div class="marquee-track" aria-hidden="true">
          {logos.map(({ src }) => (
            <img src={`${base}${src}`} alt="" class="h-9 md:h-11 w-28 md:w-32 shrink-0 object-contain brightness-0 invert opacity-60" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Gallery: masonry + filter; tiles open a modal (no case-study pages) ── -->
  <section id="work" class="relative">
    <div class="px-5 sm:px-8 md:px-12 py-16 md:py-24">
      <Gallery />
    </div>
  </section>
</Layout>

<style>
  /* Hero "Play showreel" pill. Motion (magnetic pull, jelly scale + corner
     wobble) is a spring simulation in the script below; CSS only handles
     colour, shimmer, focus ring and the touch press state. */
  .play-btn {
    position: relative;
    overflow: hidden;
    will-change: auto;
    transition: background-color 0.3s ease;
  }
  .play-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.85) 50%, transparent 70%);
    transform: translateX(-120%);
    opacity: 0;
    pointer-events: none;
  }
  .play-btn:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .play-btn:hover,
  .play-btn:focus-visible { background-color: #e4e4e7; }

  @keyframes play-shimmer {
    0%   { transform: translateX(-120%); opacity: 0.55; }
    100% { transform: translateX(120%); opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) and (pointer: fine) {
      .play-btn:hover::after { animation: play-shimmer 0.7s ease-out; }
    }
    .play-btn:focus-visible::after { animation: play-shimmer 0.7s ease-out; }
  }

  /* Touch: no hover/magnetic, just a press state. */
  @media (hover: none) {
    .play-btn:hover { background-color: #fff; }
    .play-btn:active { transform: scale(0.97); }
  }
</style>

<script>
  // Spring-driven "jelly + magnetic" for the hero Play pill.
  // The rAF loop exists only while the pointer/focus is on the button or the
  // springs are still settling; once everything is at rest it stops and all
  // inline styles are cleared. Skipped entirely on touch and reduced motion.
  function initPlayJelly() {
    const zone = document.querySelector<HTMLElement>('[data-play-zone]');
    const btn = zone?.querySelector<HTMLElement>('[data-play-btn]');
    if (!zone || !btn || zone.dataset.jellyBound) return;
    zone.dataset.jellyBound = '1';
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const MAX_PULL = 8;
    const HOVER_SCALE = 1.06;

    // Each channel: position, velocity, target, stiffness, damping.
    type Spring = { p: number; v: number; t: number; k: number; c: number };
    const mk = (p: number, k: number, c: number): Spring => ({ p, v: 0, t: p, k, c });
    const x = mk(0, 180, 16);
    const y = mk(0, 180, 16);
    const sc = mk(1, 230, 11);      // under-damped → springy overshoot
    const wob = mk(0, 260, 7);      // jelly wobble amount, kicked by impulses
    const all = [x, y, sc, wob];

    let raf = 0;
    let last = 0;
    let hovering = false;
    let focused = false;

    const apply = () => {
      // Squash & stretch from the wobble channel; corner radii shift in px so
      // they ease continuously (no px↔% interpolation).
      const w = wob.p;
      const R = btn.offsetHeight / 2;
      const sx = sc.p * (1 + w * 0.05);
      const sy = sc.p * (1 - w * 0.05);
      btn.style.transform = `translate3d(${x.p.toFixed(2)}px, ${y.p.toFixed(2)}px, 0) scale(${sx.toFixed(4)}, ${sy.toFixed(4)})`;
      const r = (m: number) => Math.max(0, R * (1 + m * w)).toFixed(1) + 'px';
      btn.style.borderRadius = `${r(0.7)} ${r(-0.5)} ${r(0.6)} ${r(-0.6)} / ${r(-0.5)} ${r(0.7)} ${r(-0.6)} ${r(0.6)}`;
    };

    const clear = () => {
      btn.style.removeProperty('transform');
      btn.style.removeProperty('border-radius');
      btn.style.removeProperty('will-change');
    };

    const step = (now: number) => {
      const dt = Math.min(0.032, (now - last) / 1000 || 0.016);
      last = now;
      const n = 2; // substeps for stability
      const h = dt / n;
      for (let i = 0; i < n; i++) {
        for (const s of all) {
          const a = -s.k * (s.p - s.t) - s.c * s.v;
          s.v += a * h;
          s.p += s.v * h;
        }
      }
      apply();
      const settled = all.every((s) => Math.abs(s.p - s.t) < 0.002 && Math.abs(s.v) < 0.01);
      if (settled && !hovering && !focused) {
        raf = 0;
        all.forEach((s) => { s.p = s.t; s.v = 0; });
        clear();
        return;
      }
      raf = requestAnimationFrame(step);
    };
    const wake = () => {
      if (raf) return;
      btn.style.willChange = 'transform';
      last = performance.now();
      raf = requestAnimationFrame(step);
    };

    const enabled = () => fine.matches && !reduced.matches;
    const engage = () => {
      sc.t = HOVER_SCALE;
      wob.v += 9;            // kick the jelly
      wake();
    };
    const release = () => {
      sc.t = 1;
      x.t = 0; y.t = 0;
      wob.v -= 4;            // small counter-wobble on release
      wake();
    };

    const move = (e: PointerEvent) => {
      const z = zone.getBoundingClientRect();
      const dx = e.clientX - (z.left + z.width / 2);
      const dy = e.clientY - (z.top + z.height / 2);
      const d = Math.hypot(dx, dy) || 1;
      const pull = Math.min(MAX_PULL, d * 0.12);
      x.t = (dx / d) * pull;
      y.t = (dy / d) * pull;
      wake();
    };

    zone.addEventListener('pointerenter', (e) => {
      if (!enabled() || e.pointerType !== 'mouse') return;
      zone.addEventListener('pointermove', move);
      wake();
    });
    zone.addEventListener('pointerleave', () => {
      zone.removeEventListener('pointermove', move);
      x.t = 0; y.t = 0;
      if (!hovering && !focused) wake();
    });
    btn.addEventListener('pointerenter', (e) => {
      if (!enabled() || e.pointerType !== 'mouse') return;
      hovering = true;
      engage();
    });
    btn.addEventListener('pointerleave', () => {
      if (!hovering) return;
      hovering = false;
      if (!focused) release();
    });
    btn.addEventListener('focus', () => {
      if (!enabled() || !btn.matches(':focus-visible')) return;
      focused = true;
      engage();
    });
    btn.addEventListener('blur', () => {
      if (!focused) return;
      focused = false;
      if (!hovering) release();
    });
  }
  document.addEventListener('astro:page-load', initPlayJelly);
</script>
