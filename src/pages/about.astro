---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog');
const featuredPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

---

<Layout
  title="About - Savelle Design"
  description="Two decades of design and development for startups, agencies, and enterprise teams. Savelle McThias, designer and developer in Scottsdale, Arizona."
>
  <!-- ── Hero: headline, line-art portrait, three paragraphs ──────────── -->
  <section class="bg-zinc-950 pt-16 md:pt-28 pb-16 md:pb-24">
    <div class="px-5 sm:px-8 md:px-12">
      <h1 data-word-reveal class="font-head text-mega md:text-9xl font-normal text-zinc-50">
        Eighteen years in, still hands-on.
      </h1>
      <div class="mt-12 md:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="min-w-0 lg:col-span-5 order-2 lg:order-1">
          <img
            src={`${base}/images/about/savelle.svg`}
            alt="Line-art portrait of Savelle McThias"
            class="w-full max-w-md mx-auto"
          />
        </div>
        <div class="min-w-0 lg:col-span-5 order-1 lg:order-2">
          <p data-word-reveal data-word-reveal-speed="fast" class="text-lg md:text-3xl text-zinc-50 text-normal">
            I started in agencies, moved through tech startups and corporate teams, and went
            independent in 2021. Somewhere in there I designed for PetSmart, General Motors,
            Universal, Plexus, and a long list of businesses you haven't heard of that just
            needed their website to work harder.
          </p>
          <p data-word-reveal data-word-reveal-speed="fast" class="mt-6 text-lg md:text-3xl text-zinc-50 text-normal">
            When you work with me, you work with me. No account managers, no juniors, no
            surprises.
          </p>
          <p data-word-reveal data-word-reveal-speed="fast" class="mt-6 text-lg md:text-3xl text-zinc-50 text-normal">
            I design and I build, and I run AI through both. That means fewer meetings, faster
            launches, and the judgment of a senior designer moving at the pace of a full team.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── From the blog: 2 posts + link to all articles ────────────────── -->
  <section class="bg-zinc-950 border-t border-zinc-900 py-24 md:py-36">
    <div class="px-5 sm:px-8 md:px-12">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-16 md:mb-20">
        <div>
          <h2 class="font-head text-huge md:text-9xl font-normal text-zinc-50">Field notes</h2>
        </div>
        <a href={`${base}/blog`} class="inline-flex items-center gap-2 font-medium text-zinc-50 underline underline-offset-8 decoration-zinc-700 hover:decoration-white transition-colors">
          View all articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredPosts.map((post) => {
          const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <a href={`${base}/blog/${post.id}`} class="group block rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800 hover:border-zinc-600 transition-colors">
              <div class="overflow-hidden">
                <img
                  src={`${base}/images/${post.data.image}`}
                  alt={post.data.imageAlt}
                  class="w-full aspect-[16/10] object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <p class="text-xs text-zinc-500 mb-3">{formattedDate}</p>
                <h3 class="text-lg font-semibold text-zinc-50 mb-2 group-hover:underline underline-offset-4 decoration-zinc-700">
                  {post.data.title}
                </h3>
                <p class="text-sm text-zinc-400 leading-relaxed">{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
