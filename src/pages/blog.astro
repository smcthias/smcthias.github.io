---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Get all blog posts from content collections and sort by date (newest first)
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title="Blog - Web Design & Development Insights | Savelle Design"
  description="Insights on UX design, web development, branding, email marketing, and e-commerce from two decades of building digital experiences that turn visitors into customers."
>
  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <section class="pt-16 md:pt-28 pb-16 md:pb-20">
    <div class="px-5 sm:px-8">
      <h1 class="text-mega font-semibold text-ink">Blog</h1>
      <p class="mt-8 text-lg md:text-xl text-slate leading-relaxed">
        Notes from real projects: what works, what fails, and what I've learned
        building for clients across industries.
      </p>
    </div>
  </section>

  <!-- ── Post index: a plain editorial list ───────────────────────────── -->
  <section class="pb-24 md:pb-36">
    <div class="px-5 sm:px-8">
      <div class="border-b border-hairline">
        {sortedPosts.map((post) => {
          const date = new Date(post.data.date);
          const formattedDate = date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          return (
            <a
              href={`${base}/blog/${post.id}`}
              class="group grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-8 md:py-10 border-t border-hairline"
            >
              <p class="min-w-0 md:col-span-3 text-sm text-mist md:pt-2">{formattedDate}</p>
              <div class="min-w-0 md:col-span-9">
                <h2 class="text-2xl md:text-3xl font-semibold text-ink group-hover:underline underline-offset-8 decoration-hairline">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-slate leading-relaxed">
                  {post.data.description}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
