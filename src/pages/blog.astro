---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Get all blog posts from content collections and sort by date (newest first)
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title="Blog - Web Design & Development Insights | Savelle Design"
  description="Real-world insights on UX design, web development, branding, email marketing, and e-commerce. Learn from 18+ years of creating effective digital experiences for growing businesses."
>
    <!-- Hero Section -->
    <section class="py-20 md:py-24">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
        <p class="spec-label mb-4">Insights</p>
        <h1 class="text-huge font-display text-paper mb-6">Blog</h1>
        <p class="text-lg md:text-xl text-muted max-w-3xl leading-relaxed">
          Insights from real projects: what works, what doesn't, and what I've learned building solutions for clients across industries.
        </p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="pb-24 md:pb-32">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-t border-line pt-12">
        {sortedPosts.map((post) => {
          // Format date
          const date = new Date(post.data.date);
          const formattedDate = date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          return (
          <a href={`${base}/blog/${post.id}`} class="group block min-w-0" data-reveal>
            <div class="relative aspect-[16/9] rounded-[2px] mb-6 overflow-hidden bg-surface border border-line">
              <img
                src={`${base}/images/${post.data.image}`}
                alt={post.data.imageAlt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="mb-2 flex items-center gap-3">
              <span class="text-sm font-medium text-faint">{post.data.category}</span>
              <span class="text-sm text-line-2">•</span>
              <span class="text-sm text-faint">{formattedDate}</span>
            </div>
            <h2 class="text-2xl font-display text-paper mb-3 group-hover:text-accent transition-colors">
              {post.data.title}
            </h2>
            <p class="text-muted mb-4 leading-relaxed">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <span class="px-3 py-1 bg-surface-2 border border-line text-muted rounded-[2px] text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </a>
          );
        })}
      </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 md:py-24 bg-surface border-y border-line">
      <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
        <div class="max-w-3xl" data-reveal>
          <h2 class="text-big font-display text-paper mb-6">
            Ready to start your project?
          </h2>
          <p class="text-lg md:text-xl text-muted mb-8 leading-relaxed">
            Whether you need a landing page, email campaigns, or a complete brand refresh, let's discuss how I can help you achieve your goals.
          </p>
          <a
            href={`${base}/contact`}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-[2px] bg-accent text-ink font-medium hover:bg-accent-dim transition-colors"
          >
            Get in Touch
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </section>

</Layout>
