---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = [
  {
    title: 'Brand & Visual',
    items: [
      { name: 'Logo and brand identity', price: '$1,500 – $3,500 flat' },
      { name: 'Ad creative and campaign assets', price: '$65/hr or $300 – $800 per deliverable' },
      { name: 'Print and digital collateral', price: '$55/hr or flat per piece' },
    ],
  },
  {
    title: 'UX & Product Design',
    items: [
      { name: 'UX audit and recommendations', price: '$1,500 – $3,000 flat', note: 'For a fixed-scope, fixed-price option, see the productized 48-Hour UX Audit.', noteHref: `${base}/ux-audit` },
      { name: 'Wireframes and user flows', price: '$75/hr' },
      { name: 'Full UI/UX design for web or app', price: '$85/hr or project-based starting at $5,000' },
    ],
  },
  {
    title: 'Web Design and Build',
    items: [
      { name: 'Webflow design and development', price: '$95/hr or $3,500 – $8,000 flat depending on scope' },
      { name: 'Landing page design and build', price: '$1,500 – $3,500 flat' },
      { name: 'Full website design and build', price: '$6,000 – $15,000 flat' },
    ],
  },
  {
    title: 'Design Systems',
    items: [
      { name: 'Component library and design system', price: '$85/hr or $4,000 – $10,000 flat' },
    ],
  },
];

const retainerTiers = [
  { hours: '10 hours/month', price: '$650' },
  { hours: '20 hours/month', price: '$1,200' },
  { hours: '40 hours/month', price: '$2,200' },
];
---

<Layout
  title="Pricing - Savelle Design"
  description="Transparent pricing for brand identity, UX and product design, web design and build, design systems, and ongoing retainer support."
>
  <!-- Hero -->
  <section class="py-20 md:py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="max-w-3xl">
        <p class="spec-label mb-4">Pricing</p>
        <h1 class="text-huge font-display text-paper mb-6">Straight rates, scoped honestly.</h1>
        <p class="text-lg md:text-xl text-muted leading-relaxed">
          General starting rates for the way I most often work with clients. Every project is
          scoped individually — flat rates depend on complexity, and these ranges are a starting
          point for that conversation, not a final quote.
        </p>
      </div>
    </div>
  </section>

  <!-- Rate Card -->
  <section class="pb-24 md:pb-32">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {categories.map((category, i) => (
          <div class="rounded-[2px] border border-line bg-surface p-8" data-reveal data-reveal-delay={i * 60}>
            <h2 class="text-xl font-display text-paper mb-2">{category.title}</h2>
            <div>
              {category.items.map((item) => (
                <div class="py-4 border-b border-line last:border-0 first:pt-4">
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                    <span class="min-w-0 text-paper font-medium">{item.name}</span>
                    <span class="text-muted sm:text-right sm:pl-6">{item.price}</span>
                  </div>
                  {item.note && (
                    <p class="text-sm text-faint mt-1.5">
                      {item.note}{' '}
                      {item.noteHref && (
                        <a href={item.noteHref} class="text-paper underline underline-offset-2 hover:text-accent transition-colors">
                          View details
                        </a>
                      )}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ongoing Retainer -->
  <section class="py-24 md:py-28 bg-surface border-y border-line">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl mb-16" data-reveal>
        <p class="spec-label mb-4">Ongoing Retainer</p>
        <h2 class="text-huge font-display text-paper mb-4">Consistent support, month to month.</h2>
        <p class="text-lg text-muted leading-relaxed">
          For businesses that need consistent design support month to month — priority turnaround, no re-onboarding, unused hours don't roll over.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {retainerTiers.map((tier, i) => (
          <div class="rounded-[2px] border border-line bg-ink p-8" data-reveal data-reveal-delay={i * 60}>
            <div class="text-big font-display text-accent mb-1">{tier.price}</div>
            <div class="text-faint mb-6">per month</div>
            <div class="text-paper font-medium">{tier.hours}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="rounded-[2px] border border-line bg-surface p-8 md:p-14" data-reveal>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
          <div class="max-w-2xl">
            <h2 class="text-big font-display text-paper mb-3">Not sure what you need?</h2>
            <p class="text-muted leading-relaxed">
              Every project is different. Tell me what you're trying to build and I'll recommend the right scope and a firm quote.
            </p>
          </div>
          <a
            href={`${base}/contact`}
            class="shrink-0 inline-flex items-center gap-2 px-7 py-3.5 rounded-[2px] bg-accent text-ink font-medium hover:bg-accent-dim transition-colors"
          >
            Get a custom quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
