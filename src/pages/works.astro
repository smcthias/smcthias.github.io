---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Get all projects from content collections and sort by date (newest first)
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const work = sortedProjects.map((p, i) => ({
  ...p,
  n: String(i + 1).padStart(2, '0'),
}));

const capabilities = [
  {
    title: 'Design',
    items: ['User interface design', 'User experience design', 'Brand identity', 'Visual design systems', 'Prototyping'],
  },
  {
    title: 'Development',
    items: ['HTML / CSS / JavaScript', 'React & modern frameworks', 'Responsive development', 'Performance optimization', 'CMS integration'],
  },
  {
    title: 'Strategy',
    items: ['User research', 'Conversion optimization', 'SEO best practices', 'Analytics & testing', 'Digital marketing'],
  },
];
---

<Layout
  title="Works - Savelle Design"
  description="Explore my portfolio of web design and development projects."
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="pt-14 md:pt-20 pb-12 md:pb-16">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <p class="text-xs font-medium text-faint uppercase tracking-[0.2em] mb-4">Selected work</p>
      <h1 class="font-display font-semibold text-mega text-paper max-w-4xl">
        Real problems, <span class="bracketed text-accent">real</span> results.
      </h1>
      <p class="mt-8 max-w-3xl text-lg md:text-xl text-muted leading-relaxed">
        Over 18+ years I've worked with companies ranging from small startups to major
        brands. Here's a selection of projects that show how I pull a thousand moving
        pieces into websites that bring in more calls, bookings, and sales.
      </p>
    </div>
  </section>

  <!-- ── Work index ───────────────────────────────────────────────────── -->
  <section class="pb-24 md:pb-32">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <ul class="divide-y divide-line border-t border-line">
        {work.map((p) => (
          <li data-reveal>
            <a href={`${base}/works/${p.id}`} class="work-row group grid grid-cols-12 items-center gap-4 py-7 md:py-8">
              <span class="col-span-2 md:col-span-1 font-display text-lg text-faint group-hover:text-accent transition-colors">{p.n}</span>
              <div class="min-w-0 col-span-10 md:col-span-5">
                <h2 class="text-big font-display text-paper group-hover:text-accent transition-colors">{p.data.title}</h2>
                <p class="text-sm text-faint mt-1">{p.data.category}</p>
              </div>
              <p class="hidden md:block min-w-0 col-span-4 text-muted leading-snug">{p.data.description}</p>
              <div class="col-span-12 md:col-span-2 mt-4 md:mt-0">
                <div class="work-thumb relative aspect-[16/10] md:aspect-[4/3] rounded-md overflow-hidden bg-surface border border-line">
                  <img src={`${base}/images/works/${p.data.thumbnail}`} alt={`${p.data.title} — ${p.data.category}`} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Core capabilities ────────────────────────────────────────────── -->
  <section class="py-24 md:py-28 bg-surface border-y border-line">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl mb-16" data-reveal>
        <p class="text-xs font-medium text-faint uppercase tracking-[0.2em] mb-4">What I bring</p>
        <h2 class="text-huge font-display text-paper">Core capabilities.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {capabilities.map((c, i) => (
          <div class="rounded-lg border border-line bg-ink p-8" data-reveal data-reveal-delay={i * 60}>
            <h3 class="text-2xl font-display text-paper mb-5">{c.title}</h3>
            <ul class="space-y-2.5 text-muted">
              {c.items.map((item) => (
                <li class="flex items-start gap-3">
                  <span aria-hidden="true" class="mt-2 w-1.5 h-1.5 shrink-0 rounded-full bg-accent"></span>
                  <span class="min-w-0">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────────── -->
  <section class="py-24 md:py-28">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="rounded-lg border border-line bg-surface p-8 md:p-14 grid grid-cols-1 md:grid-cols-12 gap-8 items-center" data-reveal>
        <div class="min-w-0 md:col-span-8">
          <h2 class="text-big font-display text-paper mb-4">Want similar results?</h2>
          <p class="text-muted max-w-2xl leading-relaxed">
            Whether you need a new landing page, a website refresh, or help with your brand
            identity, I can help you get there. Let's talk about your project.
          </p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href={`${base}/contact`} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-accent text-ink font-medium hover:bg-accent-dim transition-colors">
            Start a conversation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
