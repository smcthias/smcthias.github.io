---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { FEATURED } from '../data/featured';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Same editorial order as the homepage (FEATURED first), then anything not
// featured, newest first. Same card visual language as the homepage grid —
// the comp shows the archive using the identical card pattern, just with
// the fuller project list.
const allProjects = await getCollection('projects');
const byId = Object.fromEntries(allProjects.map((p) => [p.id, p]));
const featuredIds = new Set(FEATURED.map((f) => f.slug));
const rest = allProjects
  .filter((p) => !featuredIds.has(p.id))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const work = [...FEATURED.map((f) => byId[f.slug]), ...rest];
---

<Layout
  title="Work - Savelle Design"
  description="Selected design and development projects with real results. Two decades of work for startups, agencies, and enterprise teams."
>
  <!-- Interactive dot grid backdrop (src/scripts/dot-grid.ts): fixed,
       behind the intro section below (its bg-zinc-950 is dropped so it
       shows through; body's own bg-zinc-950 is the fallback before JS
       draws anything). Fades out as the archive grid scrolls into view.
       pointer-events-none so it never intercepts clicks — mouse position
       is read via a window-level listener instead. -->
  <canvas id="dot-grid-canvas" data-fade-trigger="#works-archive" class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true"></canvas>

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <section class="relative pt-16 md:pt-28 pb-16 md:pb-24">
    <div class="px-5 sm:px-8 md:px-12">
      <h1 data-word-reveal class="font-head font-normal text-mega md:text-9xl text-zinc-50">
        The work speaks first.
      </h1>
    </div>
  </section>

  <!-- ── Archive grid: same card language as the homepage ─────────────── -->
  <section id="works-archive" class="bg-zinc-950 pb-24 md:pb-36">
    <div class="px-5 sm:px-8 md:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16">
        {work.map((p, i) => (
          <a href={`${base}/works/${p.id}`} class="group block min-w-0">
            <div data-image-reveal class="overflow-hidden rounded-2xl bg-zinc-900">
              <img
                src={`${base}/images/works/${p.data.thumbnail}`}
                alt={`${p.data.title}, ${p.data.category}`}
                class="w-full aspect-[4/3] object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </div>
            <p data-word-reveal data-word-reveal-speed="fast" class="mt-5 md:text-xl font-medium text-zinc-50 uppercase">
              {p.data.tags.join(' • ')}
            </p>
            <h3 data-word-reveal class="mt-2 font-head text-2xl md:text-5xl font-normal text-zinc-50">{p.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
