---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = (Astro.site?.toString() || 'https://savelledesign.com').replace(/\/$/, '');

// Get all projects sorted by date for navigation
const allProjects = (await getCollection('projects')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Find current project index and get adjacent projects
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prev = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

// The markdown bodies are intentionally empty. The case study is built from
// frontmatter: brief[] carries the problem and the work, results[] carries
// the outcome. Nothing here is invented beyond connective framing.
const [lead, ...restBrief] = project.data.brief;

const detailImages = [
  project.data.images.detail1,
  project.data.images.detail2,
  project.data.images.detail3,
];

// CreativeWork JSON-LD (extends the base ProfessionalService schema in Layout).
const creativeWorkLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  url: `${siteUrl}/works/${project.id}`,
  image: `${siteUrl}/images/works/${project.data.images.hero}`,
  keywords: project.data.tags.join(', '),
  about: project.data.category,
  creator: {
    '@type': 'Person',
    name: 'Savelle McThias',
    url: `${siteUrl}/about`,
  },
};
---

<Layout title={`${project.data.title} - Savelle Design`} description={project.data.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(creativeWorkLd)} />

  <!-- ── Hero: full-bleed image ────────────────────────────────────────── -->
  <section class="bg-zinc-950">
    <div class="px-5 sm:px-8 md:px-12 pt-12 md:pt-16 pb-14 md:pb-20">
      <a href={`${base}/works`} class="group inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50 transition-colors mb-12">
        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All work
      </a>
      <h1 data-word-reveal class="font-head text-mega md:text-9xl font-normal text-zinc-50">{project.data.title}</h1>
      <p class="mt-8 text-lg md:text-xl text-zinc-50 leading-relaxed">
        {project.data.description}
      </p>
    </div>
    <img
      src={`${base}/images/works/${project.data.images.hero}`}
      alt={`${project.data.title} hero image`}
      class="w-full aspect-[16/9] max-h-[80vh] object-cover rounded-2xl md:rounded-3xl"
      loading="eager"
    />
  </section>

  <!-- ── Results strip: the outcome, visible early ────────────────────── -->
  {project.data.results.length > 0 && (
    <section class="bg-zinc-950 border-b border-zinc-900">
      <div class="px-5 sm:px-8 md:px-12 py-14 md:py-16">
        <div class="flex flex-wrap gap-x-16 gap-y-10">
          {project.data.results.map((result) => (
            <div class="min-w-0">
              <p class="font-head text-big font-semibold text-zinc-50 leading-none">{result.value}</p>
              <p class="mt-3 text-zinc-400 leading-snug">{result.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Narrative ─────────────────────────────────────────────────────── -->
  <section class="bg-zinc-950 py-20 md:py-28">
    <div class="px-5 sm:px-8 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <!-- Meta rail -->
        <aside class="min-w-0 lg:col-span-4">
          <dl class="space-y-6">
            <div>
              <dt class="text-sm text-zinc-500 mb-1">Role</dt>
              <dd class="text-zinc-50">{project.data.role}</dd>
            </div>
            <div>
              <dt class="text-sm text-zinc-500 mb-1">Timeline</dt>
              <dd class="text-zinc-50">{project.data.timeline}</dd>
            </div>
            <div>
              <dt class="text-sm text-zinc-500 mb-1">Services</dt>
              <dd class="text-zinc-50">{project.data.services}</dd>
            </div>
            <div>
              <dt class="text-sm text-zinc-500 mb-1">Tags</dt>
              <dd class="text-zinc-400">{project.data.tags.join(', ')}</dd>
            </div>
          </dl>
        </aside>

        <!-- Narrative -->
        <div class="min-w-0 lg:col-span-8">
          <h2 class="font-head text-big font-semibold text-zinc-50 mb-6">The project.</h2>
          <p class="text-xl md:text-2xl text-zinc-50 leading-relaxed">{lead}</p>
          {restBrief.length > 0 && (
            <>
              <h2 class="font-head text-big font-semibold text-zinc-50 mt-16 mb-6">The work.</h2>
              {restBrief.map((paragraph) => (
                <p class="text-lg text-zinc-400 leading-relaxed mb-6">{paragraph}</p>
              ))}
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Detail gallery: horizontal strip ──────────────────────────────── -->
  <section class="bg-zinc-950 border-t border-zinc-900">
    <div class="px-5 sm:px-8 md:px-12 py-20 md:py-28">
      <div
        class="hstrip"
        role="region"
        aria-label={`${project.data.title} detail image gallery, scrolls horizontally`}
        tabindex="0"
      >
        {detailImages.map((image, i) => (
          <img
            src={`${base}/images/works/${image}`}
            alt={`${project.data.title} detail image ${i + 1}`}
            class="h-[55vh] min-h-[320px] max-h-[680px] w-auto object-cover rounded-2xl bg-zinc-900"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Project navigation ───────────────────────────────────────────── -->
  <section class="bg-zinc-950 border-t border-zinc-900">
    <div class="px-5 sm:px-8 md:px-12 py-14 md:py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="min-w-0">
          {prev && (
            <a href={`${base}/works/${prev.id}`} class="group flex items-center gap-3 text-zinc-400 hover:text-zinc-50 transition-colors">
              <svg class="w-5 h-5 shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="min-w-0">
                <span class="block text-sm text-zinc-500">Previous</span>
                <span class="block font-medium text-zinc-50 truncate">{prev.data.title}</span>
              </span>
            </a>
          )}
        </div>
        <div class="min-w-0 sm:text-right">
          {next && (
            <a href={`${base}/works/${next.id}`} class="group flex items-center gap-3 sm:justify-end text-zinc-400 hover:text-zinc-50 transition-colors">
              <span class="min-w-0 sm:order-1">
                <span class="block text-sm text-zinc-500">Next</span>
                <span class="block font-medium text-zinc-50 truncate">{next.data.title}</span>
              </span>
              <svg class="w-5 h-5 shrink-0 sm:order-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
