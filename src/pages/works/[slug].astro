---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = (Astro.site?.toString() || 'https://savelledesign.com').replace(/\/$/, '');

// Get all projects sorted by date for navigation
const allProjects = (await getCollection('projects')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Find current project index and get adjacent projects
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prev = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

// The markdown bodies are intentionally empty — the mini case study is built
// from frontmatter: brief[] carries the problem → approach narrative, results[]
// carries the outcome. Nothing here is invented beyond connective framing.
const [lead, ...restBrief] = project.data.brief;

// CreativeWork JSON-LD (extends the base ProfessionalService schema in Layout).
const creativeWorkLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  url: `${siteUrl}/works/${project.id}`,
  image: `${siteUrl}/images/works/${project.data.images.hero}`,
  keywords: project.data.tags.join(', '),
  about: project.data.category,
  creator: {
    '@type': 'Person',
    name: 'Savelle McThias',
    url: `${siteUrl}/about`,
  },
};
---

<Layout title={`${project.data.title} - Savelle Design`} description={project.data.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(creativeWorkLd)} />

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="pt-10 md:pt-14 pb-12 md:pb-16">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <a href={`${base}/works`} class="group inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors mb-10">
        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All work
      </a>
      <p class="text-xs font-medium text-faint uppercase tracking-[0.2em] mb-4">{project.data.category}</p>
      <h1 class="font-display font-semibold text-mega text-paper max-w-4xl">{project.data.title}</h1>
      <p class="mt-8 max-w-3xl text-lg md:text-2xl text-muted leading-relaxed">
        {project.data.description}
      </p>
    </div>
  </section>

  <!-- ── Hero visual ──────────────────────────────────────────────────── -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="relative aspect-[16/9] rounded-xl overflow-hidden bg-surface border border-line" data-reveal>
        <img
          src={`${base}/images/works/${project.data.images.hero}`}
          alt={`${project.data.title} — hero`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── Overview + meta ──────────────────────────────────────────────── -->
  <section class="py-16 md:py-20 bg-surface border-y border-line">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <!-- Meta rail -->
        <aside class="min-w-0 lg:col-span-4" data-reveal>
          <p class="text-xs font-medium text-faint uppercase tracking-[0.2em] mb-6">The brief</p>
          <dl class="space-y-6">
            <div>
              <dt class="text-sm text-faint mb-1">Role</dt>
              <dd class="text-paper">{project.data.role}</dd>
            </div>
            <div>
              <dt class="text-sm text-faint mb-1">Timeline</dt>
              <dd class="text-paper">{project.data.timeline}</dd>
            </div>
            <div>
              <dt class="text-sm text-faint mb-1">Services</dt>
              <dd class="text-paper">{project.data.services}</dd>
            </div>
            <div>
              <dt class="text-sm text-faint mb-1">Tags</dt>
              <dd class="flex flex-wrap gap-2 mt-2">
                {project.data.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-md border border-line text-sm text-muted">{tag}</span>
                ))}
              </dd>
            </div>
          </dl>
        </aside>

        <!-- Narrative -->
        <div class="min-w-0 lg:col-span-8">
          <h2 class="text-huge font-display text-paper mb-8" data-reveal>The work.</h2>
          <p class="text-xl md:text-2xl text-paper leading-relaxed mb-8" data-reveal>{lead}</p>
          {restBrief.map((paragraph, i) => (
            <p class="text-lg text-muted leading-relaxed mb-6" data-reveal data-reveal-delay={i * 60}>
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Visuals ──────────────────────────────────────────────────────── -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal>
        <div class="relative aspect-[4/3] rounded-lg overflow-hidden bg-surface border border-line">
          <img
            src={`${base}/images/works/${project.data.images.detail1}`}
            alt={`${project.data.title} — detail 1`}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="relative aspect-[4/3] rounded-lg overflow-hidden bg-surface border border-line">
          <img
            src={`${base}/images/works/${project.data.images.detail2}`}
            alt={`${project.data.title} — detail 2`}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <div class="relative aspect-[16/9] rounded-lg overflow-hidden bg-surface border border-line mt-6" data-reveal>
        <img
          src={`${base}/images/works/${project.data.images.detail3}`}
          alt={`${project.data.title} — detail 3`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── Results ──────────────────────────────────────────────────────── -->
  <section class="py-20 md:py-24 bg-surface border-y border-line">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <p class="text-xs font-medium text-faint uppercase tracking-[0.2em] mb-4" data-reveal>The outcome</p>
      <h2 class="text-huge font-display text-paper mb-14" data-reveal>By the numbers.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line border border-line rounded-lg overflow-hidden">
        {project.data.results.map((result, i) => (
          <div class="min-w-0 bg-ink p-8 md:p-10" data-reveal data-reveal-delay={i * 60}>
            <div class="text-mega font-display text-accent leading-none mb-3">{result.value}</div>
            <p class="text-muted leading-snug">{result.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Project navigation ───────────────────────────────────────────── -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="min-w-0">
          {prev && (
            <a href={`${base}/works/${prev.id}`} class="group flex items-center gap-3 text-muted hover:text-accent transition-colors">
              <svg class="w-5 h-5 shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="min-w-0">
                <span class="block text-sm text-faint">Previous</span>
                <span class="block font-display text-paper group-hover:text-accent transition-colors truncate">{prev.data.title}</span>
              </span>
            </a>
          )}
        </div>
        <div class="min-w-0 sm:text-right">
          {next && (
            <a href={`${base}/works/${next.id}`} class="group flex items-center gap-3 sm:justify-end text-muted hover:text-accent transition-colors">
              <span class="min-w-0 sm:order-1">
                <span class="block text-sm text-faint">Next</span>
                <span class="block font-display text-paper group-hover:text-accent transition-colors truncate">{next.data.title}</span>
              </span>
              <svg class="w-5 h-5 shrink-0 sm:order-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────────── -->
  <section class="py-24 md:py-28 bg-surface border-t border-line">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <h2 class="text-huge font-display text-paper mb-5">{project.data.ctaHeading}</h2>
        <p class="text-lg text-muted leading-relaxed mb-10">{project.data.ctaDescription}</p>
        <a href={`${base}/contact`} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-accent text-ink font-medium hover:bg-accent-dim transition-colors">
          Start a conversation
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
